<%

words = @item_description.split(' ') rescue [];
@item_attr3.split(' ').each { |w| words.delete(w) } if @item_attr3
@item_attr4.split(' ').each { |w| words.delete(w) } if @item_attr4

chars_per_line = 15;
lines = []
number_of_lines = 2
number_of_lines.times {
  line, temp = '', '';
  words.each { |r| temp += "#{r} "; break if temp.length > chars_per_line; line = temp }
  lines << line;
  words = words[line.split(' ').length..-1];
  break if words.empty?
}
