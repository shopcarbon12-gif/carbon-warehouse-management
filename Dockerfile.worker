# Carbon WMS — background sync worker (no HTTP). Coolify: second application, same repo/branch, Dockerfile = Dockerfile.worker.
# Drains `sync_jobs` (lightspeed_pull / lightspeed_catalog queued rows). Same DATABASE_URL + Lightspeed env as the web app.
# Node 22: HyperFrames (Creative render worker, HTML → MP4) needs Node ≥ 22.
FROM node:22-alpine
RUN apk add --no-cache libc6-compat tzdata ffmpeg \
     chromium nss freetype harfbuzz ttf-freefont font-liberation
# CarbonWMS Creative renders: HyperFrames CLI (pinned) drives the system Chromium + ffmpeg.
ENV CHROMIUM_PATH=/usr/bin/chromium-browser
ENV PRODUCER_HEADLESS_SHELL_PATH=/usr/bin/chromium-browser
ENV HYPERFRAMES_FFMPEG_PATH=/usr/bin/ffmpeg
ENV HYPERFRAMES_BIN=hyperframes
RUN npm install -g hyperframes@0.9.13
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# Orlando time, same as the web app (Dockerfile runner stage).
ENV TZ=America/New_York
# tsx lives in devDependencies; worker imports @/lib (TypeScript path aliases).
ENV NPM_CONFIG_PRODUCTION=false
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY lib ./lib
COPY scripts ./scripts
CMD ["npx", "tsx", "scripts/worker.ts"]
