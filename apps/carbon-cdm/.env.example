# ── Carbon CDM agent — env file ──────────────────────────────────────────
# Copy to .env and fill in. Never commit the real .env.

# WMS server the agent reports to. No trailing slash.
CARBON_WMS_URL=https://wms.shopcarbon.com

# API token issued from the WMS at /hardware_config (Add agent → reveal token).
# This token is a long string starting with "cdm_". Treat as a secret.
CARBON_CDM_TOKEN=cdm_REPLACE_ME

# How often the agent reports its health to the WMS (seconds). Default 30.
CARBON_HEARTBEAT_INTERVAL_SEC=30

# How often the agent re-pulls reader/antenna config from the WMS (seconds).
# Lower = config changes propagate faster. Default 60.
CARBON_CONFIG_POLL_INTERVAL_SEC=60

# Where /opt/carbon-cdm/MonsoonReader lives. Once the binary is copied over
# from the legacy CDM laptop, point this at it.
CARBON_MONSOON_BINARY=/opt/carbon-cdm/MonsoonReader

# Logging level: debug | info | warn | error. Default info.
CARBON_LOG_LEVEL=info

# Optional explicit hostname this agent reports as. Default: os.hostname().
# CARBON_AGENT_HOSTNAME=
