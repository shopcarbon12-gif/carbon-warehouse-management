{
  "sections": {
    "wholesale_intro": {
      "type": "rich-text",
      "blocks": {
        "wholesale_intro_heading": {
          "type": "heading",
          "settings": {
            "text": "WHOLESALE",
            "size": "h2"
          }
        },
        "wholesale_intro_text": {
          "type": "text",
          "settings": {
            "text": "<p>Stock Carbon in your store. Tell us about your business below and we'll get back to you. Once approved, you log in with your email and see wholesale prices on every product.</p><p>Orders are placed in runs: one of every size in a colour, with a minimum of 3 runs per colour. Payment is taken at checkout.</p>",
            "size": "text-size-regular"
          }
        }
      },
      "block_order": [
        "wholesale_intro_heading",
        "wholesale_intro_text"
      ],
      "settings": {
        "section_width": "grid",
        "text_width": "medium",
        "text_position": "center",
        "text_alignment": "center",
        "color_bg": "rgba(0,0,0,0)",
        "color_text": "#151515",
        "color_links": "#151515",
        "disable_top_spacing": false,
        "disable_bottom_spacing": true
      }
    },
    "wholesale_form": {
      "type": "contact-form",
      "blocks": {
        "wholesale_business": {
          "type": "text_field",
          "settings": {
            "title": "Business name",
            "use_long_text": false,
            "is_required": true
          }
        },
        "wholesale_location": {
          "type": "text_field",
          "settings": {
            "title": "City and state",
            "use_long_text": false,
            "is_required": true
          }
        },
        "wholesale_website": {
          "type": "text_field",
          "settings": {
            "title": "Website or Instagram",
            "use_long_text": false,
            "is_required": false
          }
        },
        "wholesale_store_type": {
          "type": "dropdown_field",
          "settings": {
            "title": "Type of store",
            "values": "Boutique / physical store, Online store, Both"
          }
        }
      },
      "block_order": [
        "wholesale_business",
        "wholesale_location",
        "wholesale_website",
        "wholesale_store_type"
      ],
      "settings": {
        "heading": "",
        "description": "",
        "show_phone_number": true,
        "disable_top_spacing": false,
        "disable_bottom_spacing": false
      }
    }
  },
  "order": [
    "wholesale_intro",
    "wholesale_form"
  ]
}
