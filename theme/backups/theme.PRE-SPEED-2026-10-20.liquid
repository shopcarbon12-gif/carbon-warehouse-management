<script>
/* Accessibility attributes for elements the theme and third-party widgets render
   without them. Applied once after load, then again only when the DOM actually
   changes (cart drawer, quick view, Instagram feed, chat widget).

   Replaces a setInterval that re-ran ~40 jQuery writes every second for the whole
   life of the page, re-bound click handlers on every tick, and appended a new
   live-region div each time. No jQuery dependency. */
(function () {
  var ATTRS = [
    ['svg', 'aria-label', 'SVG Icon'],
    ['a[target="_blank"]', 'title', 'Open in a new window'],
    ['a[target="_blank"]', 'aria-label', 'Open in a new window'],
    ['.product-recommendations', 'aria-label', 'Product recommendations, you may also like'],
    ['.product-recommendations', 'role', 'group'],
    ['.product-recommendations', 'tabindex', '0'],
    ['.eapps-instagram-feed-posts-slider-next', 'aria-label', 'Instagram feed post slider'],
    ['.eapps-instagram-feed-posts-slider-next', 'role', 'button'],
    ['.product-card-swatch', 'aria-label', 'Product card swatch'],
    ['.product-card-swatch', 'role', 'button'],
    ['.product-card-swatch', 'tabindex', '0'],
    ['#kr-widget-launcher-button', 'aria-label', 'Widget launcher button'],
    ['#kr-widget-launcher-button', 'role', 'button'],
    ['#kr-widget-launcher-button', 'tabindex', '0'],
    ['.swym-background-color', 'role', 'button'],
    ['.product-card-quickview', 'tabindex', '0'],
    ['.view-products', 'tabindex', '0'],
    ['.thb-full-menu--link', 'aria-haspopup', 'true'],
    ['#NewsletterForm--sections--18613012398332__footer', 'aria-required', 'true'],
    ['#HeaderLocalization input', 'role', 'button'],
    ['#FooterLocalization input', 'role', 'button'],
    ['.testimonials__testimonial-inner p', 'role', 'heading'],
    ['.thb-widget-menu', 'role', 'menu'],
    ['.thb-widget-menu li', 'role', 'menuitem'],
    ['.search-field', 'aria-label', 'Search field, search anything'],
    ['.storepoint-address', 'tabindex', '0'],
    ['.storepoint-name', 'tabindex', '0'],
    ['.amount', 'tabindex', '0'],
    ['.mega-menu-promotion img', 'alt', 'Menu item image'],
    ['.gallery__item-content-link', 'aria-label', 'Gallery item link'],
    ['.slideshow__slide-video-bg img', 'alt', 'Slideshow background'],
    ['#Filter-Price-GTE', 'aria-label', 'Filter price, minimum'],
    ['#Filter-Price-LTE', 'aria-label', 'Filter price, maximum'],
    ['#Filter-Price-GTE-mobile', 'aria-label', 'Filter price, minimum'],
    ['#Filter-Price-LTE-mobile', 'aria-label', 'Filter price, maximum']
  ];

  function apply() {
    for (var i = 0; i < ATTRS.length; i++) {
      var sel = ATTRS[i][0], attr = ATTRS[i][1], val = ATTRS[i][2], nodes;
      try { nodes = document.querySelectorAll(sel); } catch (e) { continue; }
      for (var j = 0; j < nodes.length; j++) {
        /* never overwrite a value the theme is managing itself */
        if (!nodes[j].hasAttribute(attr)) nodes[j].setAttribute(attr, val);
      }
    }

    var sections = document.querySelectorAll('.product-section');
    for (var s = 0; s < sections.length; s++) {
      var titleEl = sections[s].querySelector('.product-title');
      var name = titleEl ? titleEl.textContent.trim() : '';
      var imgs = sections[s].querySelectorAll('.product-image-container img');
      for (var k = 0; k < imgs.length; k++) {
        if (!imgs[k].getAttribute('alt')) {
          imgs[k].setAttribute('alt', ('Carbon ' + name + ' - photo ' + (k + 1)).replace(/\s+/g, ' ').trim());
        }
      }
    }
  }

  var timer = null;
  function schedule() {
    if (timer) return;
    timer = setTimeout(function () { timer = null; apply(); }, 250);
  }

  function start() {
    apply();
    if (window.MutationObserver && document.body) {
      new MutationObserver(schedule).observe(document.body, { childList: true, subtree: true });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }
})();
</script>
