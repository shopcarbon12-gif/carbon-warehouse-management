@media (max-width: 1000px) {#carbon-size-guide-mens-swim-shorts { grid-template-columns: 1fr; }#carbon-size-guide-mens-swim-shorts .csg-top, #carbon-size-guide-mens-swim-shorts .csg-units, #carbon-size-guide-mens-swim-shorts .csg-subtitle, #carbon-size-guide-mens-swim-shorts .csg-picker, #carbon-size-guide-mens-swim-shorts .csg-chart, #carbon-size-guide-mens-swim-shorts .csg-measure, #carbon-size-guide-mens-swim-shorts .csg-tips {
