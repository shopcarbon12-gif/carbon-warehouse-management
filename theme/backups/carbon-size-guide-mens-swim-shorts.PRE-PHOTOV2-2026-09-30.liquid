}#carbon-size-guide-mens-swim-shorts .csg-table-foot { margin: 10px 2px 0; font-size: 12.5px; color: #6b7280; }/* ── how to measure ─────────────────────────────────────────────────── */
#carbon-size-guide-mens-swim-shorts .csg-measure { border: 0; min-width: 0; }#carbon-size-guide-mens-swim-shorts .csg-measure > summary {
  list-style: none; cursor: default; display: flex; align-items: center;
