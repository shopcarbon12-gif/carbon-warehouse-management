     of the comp, and only the longest tip runs to a second line. */
  margin: 0; padding: 0; list-style: none;
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px clamp(12px, 1.3vw, 20px); flex: 1 1 auto;
