}/* Two lines, as in the comp: the measurement, then its unit underneath. */
#carbon-size-guide-mens-swim-shorts .csg-th-unit { display: block; font-weight: 400; font-size: 12.5px; opacity: .85; }#carbon-size-guide-mens-swim-shorts .csg-table tbody th, #carbon-size-guide-mens-swim-shorts .csg-table tbody td {
  text-align: center; padding: 13px 8px; font-size: 16px;
