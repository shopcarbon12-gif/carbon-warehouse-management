}#carbon-size-guide-mens-swim-shorts .csg-measure > summary::-webkit-details-marker { display: none; }#carbon-size-guide-mens-swim-shorts .csg-h3 {
  margin: 0; font-family: var(--csg-display); font-weight: 600;
