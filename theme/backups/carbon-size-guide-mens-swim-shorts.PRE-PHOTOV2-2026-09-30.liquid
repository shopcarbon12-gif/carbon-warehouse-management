}#carbon-size-guide-mens-swim-shorts .csg-table tbody th { font-weight: 700; }#carbon-size-guide-mens-swim-shorts .csg-table tbody td { color: var(--csg-muted); }#carbon-size-guide-mens-swim-shorts .csg-table tbody tr:nth-child(even) th, #carbon-size-guide-mens-swim-shorts .csg-table tbody tr:nth-child(even) td { background: var(--csg-zebra); }#carbon-size-guide-mens-swim-shorts .csg-table tbody tr { cursor: pointer; }#carbon-size-guide-mens-swim-shorts .csg-table tbody tr:hover th, #carbon-size-guide-mens-swim-shorts .csg-table tbody tr:hover td { background: var(--csg-blue-soft); }/* Solid blue with white text — a tint was not readable enough as "chosen". */
#carbon-size-guide-mens-swim-shorts .csg-table tbody tr[aria-selected="true"] th, #carbon-size-guide-mens-swim-shorts .csg-table tbody tr[aria-selected="true"] td {
