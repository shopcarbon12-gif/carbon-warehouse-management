{%- liquid
	assign show_collection_image = section.settings.show_collection_image
	assign show_collection_description = section.settings.show_collection_description
	assign show_subcollections = section.settings.show_subcollections
	assign make_heading_uppercase = section.settings.make_heading_uppercase
	assign text_alignment = section.settings.text_alignment
	assign overlay_color = section.settings.overlay_color
	assign overlay_opacity = section.settings.overlay_opacity

	assign image = collection.featured_image
	assign campaign_mobile_image = nil
	case collection.handle
		when 'socks-underwear'
			assign campaign_desktop_image = images['carbon-socks-underwear-three-color-v4-desktop.png']
			assign campaign_mobile_image = images['carbon-socks-underwear-three-color-v4-mobile.png']
		when 'sunglasses-women'
			assign campaign_desktop_image = images['carbon-sunglasses-women-v4-desktop.png']
			assign campaign_mobile_image = images['carbon-sunglasses-women-v4-mobile.png']
		when 'sunglasses'
			assign campaign_desktop_image = images['carbon-sunglasses-men-v1-desktop.png']
			assign campaign_mobile_image = images['carbon-sunglasses-men-v1-mobile.png']
			assign overlay_opacity = 0
		when 'ties'
			assign campaign_desktop_image = images['carbon-ties-men-v1-desktop.png']
			assign campaign_mobile_image = images['carbon-ties-men-v1-mobile.png']
			assign overlay_opacity = 0
	endcase
	if campaign_desktop_image != blank
		assign image = campaign_desktop_image
	endif
	assign title = collection.title | split: '(' | first | strip
	assign description = collection.description
	assign collection_handle = collection.handle

	if section.settings.image and collection.handle == 'all'
		assign image = section.settings.image
	endif
-%}
{%- if template == 'search' -%}
	{%- liquid
		assign show_collection_image = false
		assign show_subcollections = false
		assign title = 'search.heading' | t
	-%}
	{%- capture description %}
		{% assign search_phrase = search.terms | replace: '*', '' %}
		{% if '' != search_phrase %}
			<p>{{ 'search.results_found' | t: count: search.results_count, key: search_phrase }}</p>
		{% endif %}
	{%- endcapture -%}
{%- endif -%}
{{ 'collection-banner.css' | asset_url | stylesheet_tag }}

<div class="collection-banner{% if collection.handle == 'sunglasses' or collection.handle == 'ties' %} carbon-accessory-campaign{% endif %} collection-banner--heading-uppercase-{{ make_heading_uppercase }}{% if show_collection_image and image %} collection-banner--has-bg{% endif %}" style="--overlay-color-rgb: {{ overlay_color.rgb | replace: ' ' , ',' }}; --overlay-opacity: {{ overlay_opacity | divided_by: 100.0 }}">
	<div class="collection-banner--breadcrumbs">
		{%- render 'breadcrumbs' -%}
	</div>
	<div class="row full-width-row">
		<div class="small-12 columns">
			{%- if show_collection_image and image -%}
			<div class="collection-banner--image">
				{%- if campaign_mobile_image != blank -%}
					<picture class="carbon-collection-campaign">
						<source media="(max-width: 767px)" srcset="{{ campaign_mobile_image | image_url: width: 375 }} 375w, {{ campaign_mobile_image | image_url: width: 750 }} 750w" sizes="100vw">
						{{ image | image_url: width: 2172 | image_tag: widths: '1086, 2172', sizes: '100vw', loading: 'eager', fetchpriority: 'high' }}
					</picture>
				{%- else -%}
					{%- render 'responsive-image', image: image, sizes: '0x350,0x700', priority: 'high' -%}
				{%- endif -%}
			</div>
			{%- endif -%}
			<div class="collection-banner--content text-{{ text_alignment }}">
				<h1 class="collection-banner--title">{{ title | escape }}</h1>
				{% if template == 'search' %}
					<form role="search" method="get" class="searchform" action="{{ routes.search_url }}">
						<fieldset>
							<input type="search" class="search-field" placeholder="{{ 'sections.header.search_for' | t | escape }}" value="{{ search.terms | replace: '*', '' }}" name="q" autocomplete="off">
							<button type="submit" class="thb-search-submit">{% render 'svg-icons' with 'search' %}</button>
						</fieldset>
					</form>
				{% endif %}
				{%- if show_collection_description and description != '' -%}
				<div class="collection-banner--description">
					{{ description }}
				</div>
				{%- endif -%}
				{%- if show_subcollections and linklists[collection_handle] != empty -%}
					{%- capture subcollection_links -%}
					{%- for link in linklists[collection_handle].links -%}
						{%- assign link_collection = collections[link.handle] -%}
						{%- if link_collection != blank -%}
							<a href="{{ link_collection.url }}" title="{{ link_collection.title | split: '(' | first | strip | escape }}" class="text-button{% if show_collection_image and image %} white{% endif %}">{{ link_collection.title | split: '(' | first | strip | escape }}</a>
						{%- endif -%}
					{%- endfor -%}
					{%- endcapture -%}
					{%- if subcollection_links != '' -%}
					<div class="collection-banner--subcollections">
						{{ subcollection_links }}
					</div>
					{%- endif -%}
				{%- endif -%}
			</div>
		</div>
	</div>
</div>

{% stylesheet %}
.carbon-collection-campaign { display: block; width: 100%; height: 100%; }
.collection-banner--description { max-width: 530px; margin: 12px auto 0; font-size: 20px; line-height: 1.5; }
.collection-banner--content .collection-banner--description p { margin: 0; font-size: inherit; }
.collection-banner--has-bg .collection-banner--description { text-shadow: 0 1px 3px rgb(0 0 0 / 45%); }
@media (max-width: 767px) { .collection-banner--description { max-width: 340px; font-size: 18px; } }
@media (min-width: 1024px) { .carbon-accessory-campaign .collection-banner--content { max-width: 34%; margin-left: 0; margin-right: auto; text-align: left; } .carbon-accessory-campaign .collection-banner--description { margin-left: 0; margin-right: 0; } }
{% endstylesheet %}

{% schema %}
  {
    "name": "Collection banner",
    "settings": [
			{
				"type": "header",
				"content": "Collection page"
			},
			
			{
	      "type": "checkbox",
	      "id": "show_collection_image",
	      "default": true,
	      "label": "Show collection image"
	    },
			{
	      "type": "checkbox",
	      "id": "show_collection_description",
	      "default": true,
	      "label": "Show collection description"
	    },
			{
	      "type": "checkbox",
	      "id": "show_subcollections",
	      "default": true,
	      "label": "Show subcollections",
				"info": "Links to subcollections from your menu will appear here. [Learn more.](https://documentation.fuelthemes.net/kb/how-do-i-add-sub-category-links-inside-main-collection-banner/)"
	    },
			{
	      "type": "checkbox",
	      "id": "make_heading_uppercase",
	      "default": false,
	      "label": "Make heading uppercase"
	    },
			{
				"type": "select",
				"id": "text_alignment",
				"options": [
					{
						"value": "left",
						"label": "Left"
					},
					{
						"value": "center",
						"label": "Center"
					},
					{
						"value": "right",
						"label": "Right"
					}
				],
				"default": "center",
				"label": "Content alignment"
			},
			{
				"type": "header",
				"content": "Catalog page"
			},
			{
				"type": "paragraph",
				"content": "Learn more about [catalog page](https://help.shopify.com/en/manual/online-store/themes/themes-by-shopify/vintage-themes/customizing-vintage-themes/change-catalog-page)"
			},
			{
        "type": "image_picker",
        "id": "image",
        "label": "Catalog image",
	      "info": "Changes the image for the [catalog page](https://help.shopify.com/en/manual/online-store/themes/themes-by-shopify/vintage-themes/customizing-vintage-themes/change-catalog-page). 1920 x 640 px .jpg recommended."
      },
			{
	      "type": "header",
	      "content": "Colors"
	    },
			{
				"type": "color",
				"id": "overlay_color",
				"label": "Overlay",
				"default": "#000000"
			},
			{
				"type": "range",
				"id": "overlay_opacity",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "%",
				"label": "Overlay opacity",
				"default": 20
			}
    ]
  }
{% endschema %}

