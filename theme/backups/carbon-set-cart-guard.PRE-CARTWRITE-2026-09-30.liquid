{% comment %}
  Keeps matching sets whole in the cart.

  Pairing at add-to-cart is not enough on its own: a shopper can still open the
  cart and delete one half, or set one piece to 2 and the other to 1, and check
  out with an outfit that cannot be fulfilled. This watches the cart and puts it
  back in step.

  Pieces are recognised by their product's carbon_set.partners metafield, read
  through /products/<handle>.js — the same source the product page uses, so the
  two agree by construction.

  Only true matching sets are held together. A pair the shopper had to mix —
  size S in one piece because their size did not exist in the other — is tagged
  when it is added and left alone here: those are two garments sold separately,
  and removing one must not silently take the other with it.

  Deliberately corrective rather than preventive: blocking the theme's own
  quantity and remove controls would mean reimplementing them for every theme
  update. Letting the change happen and then restoring the balance survives
  theme changes and is invisible when nothing is wrong.
{% endcomment %}

<script>
(function () {
  "use strict";

  var busy = false;
  var cache = {};      /* handle -> partner handles */
  var notice = null;

  function get(url) {
    return fetch(url, { credentials: "same-origin" })
      .then(function (r) { return r.ok ? r.json() : null; })
      .catch(function () { return null; });
  }

  function partnersOf(handle) {
    if (cache[handle]) return Promise.resolve(cache[handle]);
    /* The .js product endpoint does not expose metafields, so the partner list
       is read from the product page's embedded config. One fetch per distinct
       set product in the cart, cached for the page's lifetime. */
    return fetch("/products/" + handle, { credentials: "same-origin" })
      .then(function (r) { return r.ok ? r.text() : ""; })
      .then(function (html) {
        var m = html.match(/data-carbon-set-config[^>]*>([\s\S]*?)<\/script>/);
        var list = [];
        if (m) {
          try { list = (JSON.parse(m[1]).partners || []).filter(Boolean); } catch (e) { list = []; }
        }
        cache[handle] = list;
        return list;
      })
      .catch(function () { cache[handle] = []; return []; });
  }

  /*
   * Does this handle still name a real product?
   *
   * carbon_set.partners stores handles, and a handle outlives nothing: rename
   * or merge a product and the other half of the pair keeps pointing at a name
   * that resolves to a 404. One such link existed — alia-crop-tank still listed
   * alia-short-legging, gone in an earlier merge — and because a dead partner
   * can never be in the cart, the set looked permanently incomplete and the
   * guard emptied a perfectly good pair. A partner that does not exist is not
   * a missing piece; it is a stale link, and it is ignored.
   */
  var alive = {};
  function exists(handle) {
    if (alive[handle]) return Promise.resolve(true);
    return fetch("/products/" + handle + ".js", { credentials: "same-origin" })
      .then(function (r) {
        /* Only a confirmed hit is remembered. A 404 means gone, but so does a
           throttled or offline request, and caching that would quietly drop a
           real partner for the rest of the page's life. Treating the unknown
           as "not a partner" is the safe direction either way: it can only make
           the guard remove less, never empty a cart it should have left. */
        if (r.ok) alive[handle] = true;
        return r.ok;
      })
      .catch(function () { return false; });
  }

  function say(text) {
    if (!notice) {
      notice = document.createElement("div");
      notice.setAttribute("data-carbon-set-notice", "");
      notice.style.cssText =
        "margin:12px 0;padding:10px 14px;border:1px solid #d7e3f4;background:#f2f8ff;" +
        "border-radius:8px;font-size:.9rem;line-height:1.5";
      var host = document.querySelector("form[action*='/cart']") || document.querySelector("main") || document.body;
      host.insertBefore(notice, host.firstChild);
    }
    notice.textContent = text;
  }

  function update(updates, message) {
    busy = true;
    return fetch("/cart/update.js", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      credentials: "same-origin",
      body: JSON.stringify({ updates: updates }),
    })
      .then(function () {
        if (message) say(message);
        /* Reload so the theme's own cart markup and totals redraw — patching its
           DOM by hand would break on any theme update. */
        window.location.reload();
      })
      .catch(function () { busy = false; });
  }

  function check() {
    if (busy) return;
    get("/cart.js").then(function (cart) {
      if (!cart || !cart.items || !cart.items.length) return;

      var handles = {};
      cart.items.forEach(function (i) { handles[i.handle] = true; });

      Promise.all(Object.keys(handles).map(function (h) {
        return partnersOf(h).then(function (p) { return { handle: h, partners: p }; });
      })).then(function (info) {
        var setOf = {};
        info.forEach(function (x) { if (x.partners.length) setOf[x.handle] = x.partners; });
        if (!Object.keys(setOf).length) return;

        /* Drop partner handles that no longer name a product before any of this
           is used to judge whether a set is whole. */
        var mentioned = {};
        Object.keys(setOf).forEach(function (h) {
          setOf[h].forEach(function (pp) { mentioned[pp] = true; });
        });
        return Promise.all(Object.keys(mentioned).map(function (h) {
          return exists(h).then(function (ok) { return { h: h, ok: ok }; });
        })).then(function (checked) {
          var live = {};
          checked.forEach(function (r) { if (r.ok) live[r.h] = true; });
          Object.keys(setOf).forEach(function (h) {
            setOf[h] = setOf[h].filter(function (pp) { return live[pp]; });
            if (!setOf[h].length) delete setOf[h];   /* no real partners left */
          });
          if (!Object.keys(setOf).length) return;
          return balance(cart, setOf);
        });
      });
    });
  }

  function balance(cart, setOf) {
    {

        /*
         * Two kinds of line are exempt from the lockstep.
         *
         * _carbon_set_solo: bought deliberately on its own, knowing the matching
         * piece was unavailable. Pulling it out would undo that choice.
         *
         * _carbon_set_mixed: the pieces are different sizes, because the
         * shopper's size did not exist in both. That is not a matching set — it
         * is two garments that happen to go together — so removing one must not
         * take the other with it. They are sold separately.
         *
         * Everything else is a true matching set and is kept whole: remove one
         * piece and its partners go too, since half a set cannot be fulfilled.
         */
        function isExempt(i) {
          var props = i.properties || {};
          return !!(props._carbon_set_solo || props._carbon_set_mixed);
        }

        /* Total quantity per product handle, since a product can appear as more
           than one line when sizes differ. */
        var qty = {};
        cart.items.forEach(function (i) {
          if (isExempt(i)) return;
          qty[i.handle] = (qty[i.handle] || 0) + i.quantity;
        });

        var updates = {};
        var removed = null;
        var rebalanced = null;

        Object.keys(setOf).forEach(function (h) {
          if (!qty[h]) return;   /* only exempt lines remain for this product */

          /* The whole set, not just this piece and the ones still in the cart.
             Each piece lists all the others, so this is the complete group. */
          var group = [h].concat(setOf[h]);
          var missing = group.filter(function (g) { return !qty[g]; });

          if (missing.length) {
            /*
             * Any piece missing means the set cannot be fulfilled, so the rest
             * of it goes too.
             *
             * This used to remove a piece only once EVERY partner had gone,
             * which was the same thing for a two-piece set but wrong for a
             * three-piece one: taking the jacket out of Lily or Remi left the
             * top and the pants behind, each still seeing one partner present
             * and so each judged fine. A set is all of it or none of it.
             * Solo and mixed-size lines are exempt and stay where they are.
             */
            group.forEach(function (g) {
              cart.items.forEach(function (i) {
                if (i.handle === g && !isExempt(i)) updates[i.key] = 0;
              });
            });
            removed = h;
            return;
          }

          /* Quantities out of step: bring every piece down to the smallest, so
             the customer is never charged for more than a whole set. */
          var counts = group.map(function (g) { return qty[g]; });
          var min = Math.min.apply(null, counts);
          if (counts.some(function (c) { return c !== min; })) {
            group.forEach(function (ph) {
              var seen = 0;
              cart.items.forEach(function (i) {
                if (i.handle !== ph || isExempt(i)) return;
                var want = Math.max(0, Math.min(i.quantity, min - seen));
                seen += want;
                if (want !== i.quantity) updates[i.key] = want;
              });
            });
            rebalanced = true;
          }
        });

        if (!Object.keys(updates).length) return;
        update(
          updates,
          removed
            ? "Matching sets are sold together, so the rest of the set was removed with it."
            : "Matching sets are sold together, so the quantities were matched up."
        );
    }
  }

  /*
   * React to the cart actually changing, not to the page being loaded.
   *
   * This used to run on load, on two cart events, and on a poll of the header
   * count. On this theme the bin icon removes a line over AJAX and re-renders
   * the cart section in place: no load, no event either of those names, and the
   * count element is swapped rather than retyped, so nothing fired. Remove one
   * piece of a set and the rest sat there until the next full page load — which
   * is exactly what it looked like from the outside: a guard that did nothing.
   *
   * Every route to the cart goes through /cart/{add,change,update,clear}.js, so
   * that is what to watch. Both transports are wrapped because themes use
   * either, and both pass straight through — this only observes.
   */
  var CART_WRITE = /\/cart\/(add|change|update|clear)(\.js)?(\?|$)/;

  function afterCartWrite() {
    /* Let the theme finish its own re-render before reading the cart back. */
    if (busy) return;
    setTimeout(check, 250);
  }

  function watchCartWrites() {
    var of = window.fetch;
    if (typeof of === "function" && !of.__carbonSetWrapped) {
      var wrapped = function (input, init) {
        var url = typeof input === "string" ? input : (input && input.url) || "";
        var p = of.apply(this, arguments);
        if (CART_WRITE.test(String(url))) p.then(afterCartWrite, function () {});
        return p;
      };
      wrapped.__carbonSetWrapped = true;
      window.fetch = wrapped;
    }
    var XHR = window.XMLHttpRequest;
    if (XHR && XHR.prototype && !XHR.prototype.__carbonSetWrapped) {
      var open = XHR.prototype.open, send = XHR.prototype.send;
      XHR.prototype.open = function (m, u) { this.__carbonUrl = String(u || ""); return open.apply(this, arguments); };
      XHR.prototype.send = function () {
        if (CART_WRITE.test(this.__carbonUrl || "")) {
          this.addEventListener("load", afterCartWrite);
        }
        return send.apply(this, arguments);
      };
      XHR.prototype.__carbonSetWrapped = true;
    }
  }

  function boot() {
    /* Wrapped everywhere, because a cart drawer removes a line from any page,
       not only from /cart. */
    watchCartWrites();
    document.addEventListener("cart:updated", check);
    document.addEventListener("cart:refresh", check);
    document.addEventListener("carbon:set:added", afterCartWrite);
    /* A load of the cart page still gets one check, to repair a cart that was
       left out of step by an older session. */
    if (/\/cart/.test(window.location.pathname)) check();
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
  else boot();
})();
</script>
