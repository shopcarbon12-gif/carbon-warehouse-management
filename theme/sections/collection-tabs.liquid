{{- 'product-grid.css' | asset_url | stylesheet_tag -}}
{{- 'collection-tabs.css' | asset_url | stylesheet_tag -}}
<style>
  .carbon-set-card .product-featured-image { position: relative; }
  .carbon-set-card .carbon-set-badge { position: absolute; top: 12px; left: 12px; z-index: 30; display: inline-block; background: #151515; color: #fff !important; font-size: 11px !important; line-height: 1 !important; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; padding: 6px 10px; pointer-events: none; }
  .carbon-set-card .carbon-set-pieces { margin: 6px 0 4px; font-size: 13px; line-height: 1.4; opacity: .75; }
  .carbon-set-card .carbon-set-pieces a { color: inherit; text-decoration: none; }
  .carbon-set-card .carbon-set-pieces a:hover { text-decoration: underline; }
  .carbon-set-card .carbon-set-total { font-weight: 600; }
</style>
{%- liquid
	assign section_heading = section.settings.heading
	assign section_heading_left = section.settings.heading_left
	assign section_description = section.settings.description
	assign full_width = section.settings.full_width
	assign columns_desktop = section.settings.columns_desktop
	assign show_view_all = section.settings.show_view_all
	assign show_progress_bar = section.settings.show_progress_bar
	assign product_limit = section.settings.product_limit

	assign disable_top_spacing = section.settings.disable_top_spacing
	assign disable_bottom_spacing = section.settings.disable_bottom_spacing

	assign columns_class = 'medium-6 large-4'
	assign more_in_collection = false
	case columns_desktop
		when 2
			assign columns_class = 'medium-6'
		when 3
			assign columns_class = 'medium-4'
		when 4
			assign columns_class = 'medium-6 large-3'
	endcase

	if section.blocks
		assign first_collection = section.blocks[0].settings.collection
		if first_collection.all_products_count > product_limit
	    assign more_in_collection = true
	  endif
		if show_view_all and more_in_collection
			assign section_heading_button = first_collection
		endif
	endif
-%}
<div class="collection-tabs section-spacing{% if disable_top_spacing %} section-spacing--disable-top{% endif %}{% if disable_bottom_spacing %} section-spacing--disable-bottom{% endif %}">
	<div class="row{% if full_width %} full-width-row{% endif %}">
		<div class="small-12 columns">
			{% render 'section-header', section_heading: section_heading, section_description: section_description, section_heading_left: section_heading_left, section_heading_button: section_heading_button, section_id: section.id, blocks: section.blocks %}
			<slide-show id="product-grid-{{ section.id }}" data-id="{{ section.id }}" class="products carousel row small-up-2 medium-up-{{ columns_desktop }}">
    {% for block in section.blocks %}
        {% assign mainloop = forloop %}
        {% if block.settings.collection != blank %}
            {%- if block.settings.enable_promotion -%}
                {%- unless gallery_enabled -%}
                    {{- 'gallery.css' | asset_url | stylesheet_tag -}}
                    {%- assign gallery_enabled = true -%}
                {%- endunless -%}
                <div
                    class="promotion-column {{ columns_class }} columns{% if mainloop.first == true %} carousel__slide{% endif %}"
                    data-collection="{{ block.settings.collection.handle }}"
                >
                    {%- render 'product-promotion', block: block -%}
                </div>
            {%- endif -%}

            {%- comment -%} CARBON (owner, 2026-10-27): a set shows as one card with every piece and the set price, never piece by piece — see snippets/carbon-set-card. {%- endcomment -%}
            {%- assign set_seen = '|' -%}{%- assign shown = 0 -%}
            {%- for product in block.settings.collection.products -%}
                {%- if shown >= product_limit -%}{%- break -%}{%- endif -%}
                {%- assign set_key = '|' | append: product.handle | append: '|' -%}
                {%- if set_seen contains set_key -%}{%- continue -%}{%- endif -%}
                {%- if product.available -%}  <!-- ✅ Hide out-of-stock products -->
                    {%- assign set_partners = product.metafields.carbon_set.partners.value -%}
                    <div class="{{ columns_class }} columns{% if mainloop.first == true %} carousel__slide{% endif %}" data-collection="{{ block.settings.collection.handle }}">
                        {%- if set_partners.size > 0 -%}
                            {%- for h in set_partners -%}{%- assign set_seen = set_seen | append: h | append: '|' -%}{%- endfor -%}
                            {% render 'carbon-set-card', set_lead: product, set_collection: block.settings.collection %}
                        {%- else -%}
                            {% render 'product-card', product_card_product: product %}
                        {%- endif -%}
                    </div>
                    {%- assign set_seen = set_seen | append: product.handle | append: '|' -%}
                    {%- assign shown = shown | plus: 1 -%}
                {%- endif -%}
            {%- endfor -%}

        {% else %}
            {%- if block.settings.enable_promotion -%}
                {%- unless gallery_enabled -%}
                    {{- 'gallery.css' | asset_url | stylesheet_tag -}}
                    {%- assign gallery_enabled = true -%}
                {%- endunless -%}
                <div
                    class="promotion-column {{ columns_class }} columns{% if mainloop.first == true %} carousel__slide{% endif %}"
                    data-collection="{{ block.settings.collection.handle }}"
                >
                    {%- render 'product-promotion', block: block -%}
                </div>
            {%- endif -%}

            {%- for i in (1..product_limit) -%}
                <div class="{{ columns_class }} columns{% if mainloop.first == true %} carousel__slide{% endif %}" data-collection="collection-{{ block.id }}">
                    {% render 'product-card' %}
                </div>
            {%- endfor -%}
        {% endif %}
    {%- endfor -%}

    {%- if product_limit > columns_desktop -%}
        {%- render 'slideshow-arrows' -%}
    {%- endif -%}
</slide-show>

			{%- if show_progress_bar -%}
			<div class="flickity-progress">
				<div class="flickity-progress--bar"></div>
			</div>
			{%- endif -%}
		</div>
	</div>
</div>
<script src="{{ 'collection-tabs.js' | asset_url }}" defer="defer"></script>
{% schema %}
  {
    "name": "Collection tabs",
		"class": "section-collection-tabs",
		"max_blocks": 4,
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Collection Tabs"
      },
			{
				"type": "checkbox",
				"id": "heading_left",
				"default": false,
				"label": "Left align heading"
			},
      {
        "type": "richtext",
        "id": "description",
        "label": "Description",
        "default": "<p>Add a short description for your collections</p>"
      },
			{
				"type": "checkbox",
				"id": "full_width",
				"label": "Make section full width",
				"default": true
			},
			{
	      "type": "range",
	      "id": "product_limit",
	      "min": 2,
	      "max": 16,
	      "step": 1,
	      "default": 6,
	      "label": "Number of products to show"
	    },
			{
	      "type": "range",
	      "id": "columns_desktop",
	      "min": 2,
	      "max": 4,
	      "step": 1,
	      "default": 4,
	      "label": "Number of columns on desktop"
	    },
	    {
	      "type": "checkbox",
	      "id": "show_view_all",
	      "default": true,
	      "label": "Enable \"View all\" button",
				"info": "Enable \"View all\" button if collection includes more products than shown"
	    },
			{
				"type": "checkbox",
				"id": "show_progress_bar",
				"label": "Show progress bar",
				"default": true
			},
			{
        "type": "header",
        "content": "Spacing"
      },
			{
				"type": "checkbox",
				"id": "disable_top_spacing",
				"default": false,
				"label": "Remove top spacing"
			},
			{
				"type": "checkbox",
				"id": "disable_bottom_spacing",
				"default": false,
				"label": "Remove bottom spacing"
			}
    ],
		"blocks": [
      {
        "type": "collection",
        "name": "Collection",
        "settings": [
          {
            "type": "collection",
            "id": "collection",
            "label": "Collection"
          },
					{
						"type": "header",
						"content": "Promotion"
					},
					{
						"type": "checkbox",
						"id": "enable_promotion",
						"label": "Enable promotion",
						"default": false
					},
					{
						"type": "image_picker",
						"id": "image",
						"label": "Image"
					},
					{
						"type": "text",
						"id": "title",
						"default": "Promotion heading",
						"label": "Heading"
					},
					{
						"type": "textarea",
						"id": "text",
						"default": "Advertise a promotion or a sale",
						"label": "Description"
					},
					{
						"id": "link_label",
						"type": "text",
						"label": "Button label",
						"default": "Explore",
						"info": "Leave the label blank to hide the button."
					},
					{
						"type": "select",
						"id": "content_position",
						"label": "Content position",
						"options": [
							{ "value": "top-left", "label": "Top left" },
							{ "value": "top-center", "label": "Top center" },
							{ "value": "top-right", "label": "Top right" },
							{ "value": "middle-left", "label": "Middle left" },
							{ "value": "middle-center", "label": "Middle center" },
							{ "value": "middle-right", "label": "Middle right" },
							{ "value": "bottom-left", "label": "Bottom left" },
							{ "value": "bottom-center", "label": "Bottom center" },
							{ "value": "bottom-right", "label": "Bottom right" }
						],
						"default": "bottom-left"
					},
					{
						"type": "select",
						"id": "text_alignment",
						"options": [
							{
								"value": "left",
								"label": "Left"
							},
							{
								"value": "center",
								"label": "Center"
							},
							{
								"value": "right",
								"label": "Right"
							}
						],
						"default": "left",
						"label": "Content alignment"
					},
					{
						"id": "link",
						"type": "url",
						"label": "Button link"
					},
					{
						"type": "checkbox",
						"id": "use_text_button",
						"label": "Use text button",
						"default": false
					},
					{
						"id": "block_link",
						"type": "url",
						"label": "Link",
						"info": "This will allow you to set a link to the promotion"
					},
					{
						"type": "header",
						"content": "Colors"
					},
					{
						"type": "color",
						"id": "overlay_color",
						"label": "Overlay",
						"default": "#000000"
					},
					{
						"type": "range",
						"id": "overlay_opacity",
						"min": 0,
						"max": 100,
						"step": 1,
						"unit": "%",
						"label": "Overlay opacity",
						"default": 70
					}
				]
			}
		],
    "presets": [
      {
        "name": "Collection tabs",
				"blocks": [
					{
						"type": "collection"
					},
					{
						"type": "collection"
					},
					{
						"type": "collection"
					}
				]
      }
    ],
		"enabled_on": {
			"templates": ["*"],
			"groups": [
				"header", "footer"
			]
		}
  }

{% endschema %}
