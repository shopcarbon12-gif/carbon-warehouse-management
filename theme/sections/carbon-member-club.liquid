{% comment %}
  Carbon Member Club (owner's mockups, 2026-11-03) — /pages/member-club.
  Desktop: left account sidebar (Rewards · Purchases · Settings), balance and
  tier on top, redeem + referral beside points activity, latest online order
  and in-store receipt. Phone: tab bar, balance, redeem buttons side by side,
  tier card, activity, refer a friend, one recent-purchases list.

  Data — nothing here is invented:
   - points, tier, activity, codes, referral: Carbon Rewards through the app
     proxy (/apps/loyalty/balance, redeem, cancel), the same calls as the cart
     points box; Shopify signs each request with the logged-in customer.
   - online orders: this customer's own orders from Liquid (customer.orders).
   - in-store receipts and points per purchase: /apps/loyalty/purchases.
  Each source can fail on its own; the rest of the page still shows.

  Signed out → a sign-in prompt. Sample data only on an unpublished theme
  with ?mc_demo=1, for design review.
{% endcomment %}
{%- liquid
  assign demo_allowed = false
  if theme.role != 'main'
    assign demo_allowed = true
  endif
  assign signed_in = false
  if customer
    assign signed_in = true
  endif
-%}
<style>
  @font-face {
    font-family: 'Carbon Neuzeit';
    src: url('{{ 'carbon-neuzeit-grotesk-w01-regular.otf' | asset_url }}') format('opentype');
    font-weight: 400;
    font-display: swap;
  }
  .mc {
    --mc-blue: #164bff;
    --mc-blue-ink: #1240d8;
    --mc-ink: #0b0c10;
    --mc-muted: #5b6070;
    --mc-line: #dfe3ea;
    --mc-side: #f3f5f9;
    --mc-soft: #eef3ff;
    --mc-ok: #0b7a3e;
    --mc-brand: 'Carbon Neuzeit', 'Helvetica Neue', Arial, sans-serif;
    color: var(--mc-ink);
    background: #fff;
    font-family: var(--mc-brand);
    font-size: 16px;
    line-height: 1.45;
    letter-spacing: 0;
  }
  .mc h1, .mc h2, .mc h3, .mc p, .mc button, .mc a, .mc li, .mc small, .mc strong { font-family: var(--mc-brand); }
  .mc *, .mc *::before, .mc *::after { box-sizing: border-box; }
  .mc button { font: inherit; }
  .mc a { color: inherit; }
  .mc [hidden] { display: none !important; }
  .mc__wrap { display: grid; grid-template-columns: 280px minmax(0, 1fr); min-height: 70vh; border-top: 1px solid var(--mc-line); }
  .mc__side { background: var(--mc-side); border-right: 1px solid var(--mc-line); padding: 44px 24px; display: flex; flex-direction: column; }
  .mc__signout {
    display: flex; align-items: center; gap: 14px; min-height: 48px; padding: 10px 16px; margin-top: auto;
    border-radius: 6px; color: var(--mc-ink); font-size: 18px; text-decoration: none;
  }
  .mc__signout:hover { background: #e6eaf2; }
  .mc__signout--phone { display: none; }
  .mc__eyebrow { font-family: var(--mc-brand); font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; margin: 0; }
  .mc__side h2 { font-family: var(--mc-brand); font-size: 30px; line-height: 1.1; margin: 6px 0 10px; -webkit-text-stroke: 0.6px currentColor; }
  .mc__side p { margin: 0 0 28px; color: var(--mc-ink); font-size: 15px; }
  .mc__nav { display: grid; gap: 6px; }
  .mc__nav button, .mc__tabs button {
    display: flex; align-items: center; gap: 14px; width: 100%; min-height: 48px; padding: 10px 16px;
    border: 0; border-radius: 6px; background: transparent; color: var(--mc-ink); font-size: 18px; cursor: pointer; text-align: left;
  }
  .mc__nav button[aria-current='page'] { background: var(--mc-blue); color: #fff; }
  .mc__nav button:not([aria-current='page']):hover { background: #e6eaf2; }
  .mc button:focus-visible, .mc a:focus-visible { outline: 2px solid var(--mc-blue); outline-offset: 2px; }
  .mc svg { flex: none; }
  .mc__tabs { display: none; }
  .mc__main { padding: 44px clamp(20px, 3vw, 48px) 56px; min-width: 0; }

  /* Rewards grid — desktop areas; the phone order is set below. */
  .mc__grid {
    display: grid; gap: 28px 40px; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    grid-template-areas: 'bal tier' 'redeem act' 'refer act' 'recent store';
    align-items: start;
  }
  .mc-bal { grid-area: bal; } .mc-tier { grid-area: tier; } .mc-redeem { grid-area: redeem; }
  .mc-act { grid-area: act; } .mc-refer { grid-area: refer; } .mc-recent { grid-area: recent; }
  .mc-store { grid-area: store; } .mc-plist { display: none; }

  .mc-label { font-family: var(--mc-brand); color: var(--mc-blue); font-size: 16px; letter-spacing: 0.24em; text-transform: uppercase; margin: 0 0 6px; }
  .mc h1.mc-title { font-family: var(--mc-brand); font-size: clamp(44px, 5vw, 64px); line-height: 1; margin: 0 0 14px; letter-spacing: -0.01em; -webkit-text-stroke: 1.6px currentColor; }
  .mc-intro { font-size: 19px; margin: 0 0 22px; max-width: 30em; }
  .mc-points { display: flex; align-items: baseline; gap: 12px; margin: 0; }
  .mc-points b { font-family: var(--mc-brand); color: var(--mc-blue); font-size: clamp(96px, 11vw, 150px); line-height: 0.95; letter-spacing: -0.03em; -webkit-text-stroke: 4px var(--mc-blue); }
  .mc-points span { font-family: var(--mc-brand); font-size: 34px; -webkit-text-stroke: 0.8px currentColor; }
  .mc-upto { margin: 18px 0 0; font-size: 15px; letter-spacing: 0.3em; text-transform: uppercase; }

  .mc-card { border: 1px solid var(--mc-line); border-radius: 6px; background: #fff; padding: 20px 22px; min-width: 0; }
  .mc-tier { border-left: 1px solid var(--mc-line); padding: 6px 0 6px 28px; }
  .mc-tier__head { display: flex; gap: 18px; align-items: center; margin-bottom: 18px; }
  .mc-tier__badge { flex: none; width: 72px; height: 72px; display: grid; place-items: center; clip-path: polygon(50% 0, 93% 25%, 93% 75%, 50% 100%, 7% 75%, 7% 25%); }
  .mc-tier__badge img { width: 46%; height: auto; }
  .mc-tier__name { font-family: var(--mc-brand); font-size: 32px; margin: 0; -webkit-text-stroke: 0.8px currentColor; }
  .mc-tier__sub { margin: 2px 0 0; font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--mc-muted); }
  .mc-bar { height: 16px; border-radius: 99px; background: #e3e6ec; overflow: hidden; margin: 10px 0; }
  .mc-bar i { display: block; height: 100%; border-radius: 99px; background: var(--mc-blue); }
  .mc-perks { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 8px; font-size: 18px; }
  .mc-perks li { display: flex; gap: 12px; align-items: center; }
  .mc-ends { display: none; justify-content: space-between; gap: 12px; color: var(--mc-ink); }

  .mc-btns { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
  .mc-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 14px; min-height: 52px; padding: 12px 22px;
    border: 2px solid var(--mc-blue); border-radius: 6px; background: #fff; color: var(--mc-blue-ink); cursor: pointer; text-decoration: none; font-weight: 600;
  }
  .mc-btn--fill, .mc a.mc-btn--fill { background: var(--mc-blue); color: #fff; }
  .mc a.mc-btn:not(.mc-btn--fill) { color: var(--mc-blue-ink); }
  .mc-btn--fill:hover { background: var(--mc-blue-ink); }
  .mc-btn:not(.mc-btn--fill):hover { background: var(--mc-soft); }
  .mc-btn[disabled] { opacity: 0.55; cursor: progress; }
  .mc-redeem .mc-btn { justify-content: flex-start; padding: 14px 22px; text-align: left; }
  .mc-redeem .mc-btn:not(.mc-btn--fill) { border-color: var(--mc-line); color: var(--mc-ink); }
  .mc-btn__big { display: block; font-size: 21px; font-weight: 700; }
  .mc-btn__small { display: block; font-size: 15px; font-weight: 400; }
  .mc-phone-text { display: none; }
  .mc-note { margin: 10px 0 0; color: var(--mc-muted); font-size: 14px; }

  .mc-refer { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 18px; align-items: center; }
  .mc-refer h3 { font-size: 21px; margin: 0 0 4px; }
  .mc-refer p { margin: 0; font-size: 14px; }

  .mc-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 12px; }
  .mc-head h3 { font-size: 22px; margin: 0; }
  .mc-link { color: var(--mc-blue-ink); background: none; border: 0; padding: 4px 0; cursor: pointer; text-decoration: none; font-weight: 600; }
  .mc-link:hover { text-decoration: underline; }
  .mc-rows > * + * { border-top: 1px solid var(--mc-line); }
  .mc-row { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; gap: 14px; align-items: center; padding: 10px 2px; }
  .mc-row strong { display: block; font-weight: 600; }
  .mc-row small { color: var(--mc-muted); font-size: 13px; }
  .mc-pts { color: var(--mc-blue-ink); font-weight: 700; white-space: nowrap; }
  .mc-pts--neg { color: var(--mc-ink); font-weight: 500; }
  .mc-unit-phone { display: none; }

  .mc-buy { display: grid; grid-template-columns: 120px minmax(0, 1fr) auto; gap: 18px; align-items: center; }
  .mc-thumb { width: 120px; aspect-ratio: 1; border-radius: 6px; background: #f1f2f5 center / cover no-repeat; display: grid; place-items: center; color: var(--mc-muted); }
  .mc-thumb--sm { width: 72px; }
  .mc-pill { display: inline-block; border-radius: 99px; padding: 2px 10px; font-size: 13px; background: #eceef2; color: var(--mc-ink); vertical-align: middle; }
  .mc-pill--ok { background: #e6f6ec; color: var(--mc-ok); border: 1px solid #9bd3b0; }
  .mc-pill--bad { background: #fde8e8; color: #9b1c1c; }
  .mc-meta { color: var(--mc-ink); font-size: 14px; margin: 4px 0 0; }

  .mc-banner { border: 1px solid var(--mc-line); border-radius: 6px; padding: 14px 18px; margin: 0 0 24px; background: var(--mc-soft); }
  .mc-banner--err { background: #fff3f3; border-color: #f2c4c4; }
  .mc-code { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-top: 8px; }
  .mc-code code { font-size: 18px; font-weight: 700; padding: 6px 10px; border: 1px dashed var(--mc-blue); border-radius: 4px; user-select: all; }
  .mc-status { font-size: 14px; color: var(--mc-ok); }
  .mc-status--err { color: #9b1c1c; }
  .mc-skel { height: 18px; border-radius: 4px; background: linear-gradient(90deg, #eef0f4, #f7f8fa, #eef0f4); margin: 10px 0; }
  .mc-empty { color: var(--mc-muted); margin: 6px 0; }
  .mc-section + .mc-section { margin-top: 36px; }
  .mc-settings a { display: flex; justify-content: space-between; align-items: center; padding: 16px 4px; text-decoration: none; font-size: 18px; }
  .mc-signin { max-width: 560px; margin: 0 auto; padding: 72px 20px; text-align: center; }
  .mc-signin h1 { font-family: var(--mc-brand); font-size: 44px; margin: 6px 0 12px; -webkit-text-stroke: 1.2px currentColor; }

  @media (prefers-reduced-motion: no-preference) {
    .mc-btn, .mc__nav button { transition: background-color 0.15s ease, color 0.15s ease; }
    .mc-bar i { transition: width 0.6s ease; }
  }

  /* -------- Phone and small tablets: the phone mockup -------- */
  @media (max-width: 899px) {
    .mc__wrap { grid-template-columns: minmax(0, 1fr); border-top: 0; }
    .mc__side { display: none; }
    .mc__signout--phone { display: flex; margin-top: 32px; border-top: 1px solid var(--mc-line); border-radius: 0; padding: 18px 4px 0; }
    .mc__tabs { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 2px solid var(--mc-line); margin: 0 16px; }
    .mc__tabs button { justify-content: center; font-size: 18px; border-radius: 0; margin-bottom: -2px; border-bottom: 3px solid transparent; }
    .mc__tabs button[aria-current='page'] { color: var(--mc-blue-ink); border-bottom-color: var(--mc-blue); font-weight: 700; }
    .mc__main { padding: 20px 16px 40px; }
    .mc__grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'bal' 'redeem' 'tier' 'act' 'refer' 'plist'; gap: 22px; }
    .mc-recent, .mc-store, .mc-label, .mc-intro, .mc-desk-text, .mc-perks, .mc-tier__sub, .mc-redeem__icon { display: none; }
    .mc-plist { display: block; grid-area: plist; }
    .mc h1.mc-title { font-size: 40px; margin-bottom: 10px; }
    .mc-points b { font-size: 92px; -webkit-text-stroke: 3px var(--mc-blue); }
    .mc-points span { font-size: 30px; }
    .mc-upto { letter-spacing: 0; text-transform: none; font-size: 20px; margin-top: 4px; }
    .mc-btns { grid-template-columns: 1fr 1fr; gap: 12px; }
    .mc-redeem .mc-btn, .mc-redeem .mc-btn:not(.mc-btn--fill) { justify-content: center; background: var(--mc-blue); color: #fff; border-color: var(--mc-blue); text-align: center; padding: 14px 8px; }
    .mc-phone-text { display: inline; font-size: 17px; font-weight: 700; }
    .mc-tier { border: 1px solid var(--mc-line); border-radius: 8px; padding: 18px; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 16px; align-items: center; }
    .mc-tier__head { display: contents; }
    .mc-tier__name { font-size: 26px; }
    .mc-ends { display: flex; }
    .mc-tier__badge { grid-row: span 2; align-self: start; }
    .mc-tier__badge { width: 86px; height: 86px; }
    .mc-tier > div:last-child { grid-column: 2; }
    .mc-unit-desk { display: none; }
    .mc-unit-phone { display: inline; }
    .mc-act { border-radius: 8px; }
    .mc-refer { background: var(--mc-soft); grid-template-columns: auto minmax(0, 1fr); border-radius: 8px; }
    .mc-refer .mc-btn { grid-column: 2; justify-self: start; background: var(--mc-blue); color: #fff; }
    .mc-buy { grid-template-columns: 88px minmax(0, 1fr); }
  }
  @media (max-width: 420px) {
    .mc-points b { font-size: 76px; }
    .mc-phone-text { font-size: 15px; }
    .mc__tabs button { font-size: 16px; padding: 10px 4px; }
  }
</style>

<div class="mc" id="MemberClub-{{ section.id }}">
  {%- if customer == nil -%}
    <div class="mc-signin" data-mc-signed-out>
      <p class="mc-label">Carbon Member Club</p>
      <h1>Rewards</h1>
      <p>Sign in to see your points, redeem rewards and view your online and in-store purchases.</p>
      <p><a class="mc-btn mc-btn--fill" href="{{ routes.storefront_login_url }}">Sign in</a></p>
      <p class="mc-note">New here? Sign in with your email to join — you earn points on every purchase. <a href="/pages/rewards">How Carbon Rewards works</a></p>
    </div>
  {%- endif -%}

  <div class="mc__wrap" data-mc-app {% if customer == nil %}hidden{% endif %}>
    <aside class="mc__side" aria-label="My account">
      <p class="mc__eyebrow">My account</p>
      <h2>Member Club</h2>
      <p>Your CARBON rewards, orders, and account settings.</p>
      <nav class="mc__nav" aria-label="Member Club">
        <button type="button" data-tab="rewards" aria-current="page">{% render 'carbon-member-club-icon', icon: 'gift' %}Rewards</button>
        <button type="button" data-tab="purchases">{% render 'carbon-member-club-icon', icon: 'box' %}Purchases</button>
        <button type="button" data-tab="settings">{% render 'carbon-member-club-icon', icon: 'gear' %}Settings</button>
      </nav>
      <a class="mc__signout" href="{{ routes.account_logout_url }}">{% render 'carbon-member-club-icon', icon: 'signout' %}Sign out</a>
    </aside>
    <nav class="mc__tabs" aria-label="Member Club">
      <button type="button" data-tab="rewards" aria-current="page">Rewards</button>
      <button type="button" data-tab="purchases">Purchases</button>
      <button type="button" data-tab="settings">Settings</button>
    </nav>

    <div class="mc__main">
      <div data-panel="rewards">
        <div data-mc-banners></div>
        <div class="mc__grid">
          <div class="mc-bal">
            <p class="mc-label">Carbon Member Club</p>
            <h1 class="mc-title">Rewards</h1>
            <p class="mc-intro">Earn points, unlock member perks, and turn your loyalty into exclusive rewards.</p>
            <p class="mc-points" aria-live="polite"><b data-mc-balance>…</b><span>points</span></p>
            <p class="mc-upto" data-mc-upto></p>
          </div>
          <div class="mc-tier" data-mc-tier><div class="mc-skel"></div><div class="mc-skel"></div></div>
          <div class="mc-redeem" data-mc-redeem></div>
          <div class="mc-card mc-refer" data-mc-refer hidden></div>
          <div class="mc-act" data-mc-activity><div class="mc-head"><h3>Points activity</h3></div><div class="mc-skel"></div></div>
          <div class="mc-card mc-recent" data-mc-recent><div class="mc-head"><h3>Recent purchases</h3></div><div class="mc-skel"></div></div>
          <div class="mc-card mc-store" data-mc-store><div class="mc-head"><h3>In-store receipt</h3></div><div class="mc-skel"></div></div>
          <div class="mc-card mc-plist" data-mc-plist><div class="mc-head"><h3>Recent purchases</h3></div><div class="mc-skel"></div></div>
        </div>
      </div>

      <div data-panel="purchases" hidden>
        <h1 class="mc-title">Purchases</h1>
        <section class="mc-section" aria-labelledby="mc-online-h">
          <div class="mc-head"><h3 id="mc-online-h">Online orders</h3><a class="mc-link" href="{{ routes.account_url }}">Order history →</a></div>
          <div class="mc-rows" data-mc-online-all></div>
        </section>
        <section class="mc-section" aria-labelledby="mc-store-h">
          <div class="mc-head"><h3 id="mc-store-h">In-store purchases</h3></div>
          <div class="mc-rows" data-mc-store-all><div class="mc-skel"></div></div>
        </section>
      </div>

      <div data-panel="settings" hidden>
        <h1 class="mc-title">Settings</h1>
        <div class="mc-rows mc-settings">
          <a href="https://account.shopcarbon.com/profile">Profile, addresses and email preferences <span aria-hidden="true">→</span></a>
          <a href="{{ routes.account_url }}">Order history and returns <span aria-hidden="true">→</span></a>
          <a href="{{ routes.account_logout_url }}">Sign out <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <a class="mc__signout mc__signout--phone" href="{{ routes.account_logout_url }}">{% render 'carbon-member-club-icon', icon: 'signout' %}Sign out</a>
    </div>
  </div>
</div>

<script src="{{ 'carbon-rewards-core.js' | asset_url }}" defer></script>

{%- if customer -%}
  {%- comment -%} This customer's own online orders, newest first (Shopify's data). {%- endcomment -%}
  <script type="application/json" id="MemberClubOrders-{{ section.id }}">
    [
    {%- for order in customer.orders limit: 20 -%}
      {%- liquid
        assign first = order.line_items | first
        assign again = ''
        for li in order.line_items
          if li.variant and li.variant.available and li.gift_card == false
            assign again = again | append: li.variant_id | append: ':' | append: li.quantity | append: ','
          endif
        endfor
        assign again = again | remove_last: ','
        assign image = nil
        for li in order.line_items
          if li.image
            assign image = li.image
            break
          endif
        endfor
      -%}
      {
        "id": {{ order.id | json }},
        "name": {{ order.name | json }},
        "at": {{ order.created_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
        "cancelled_at": {% if order.cancelled %}{{ order.cancelled_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }}{% else %}null{% endif %},
        "financial": {{ order.financial_status | json }},
        "total": {{ order.total_price | divided_by: 100.0 | json }},
        "items": {{ order.item_count | json }},
        "title": {{ first.product.title | default: first.title | json }},
        "lines": {{ order.line_items.size | json }},
        "image": {% if image %}{{ image | image_url: width: 300 | json }}{% else %}null{% endif %},
        "url": {{ order.customer_url | json }},
        "again": {% if again != blank %}{{ '/cart/' | append: again | json }}{% else %}null{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
    ]
  </script>
{%- endif -%}

<script>
  (() => {
    const root = document.getElementById('MemberClub-{{ section.id }}');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const signedIn = {{ signed_in | json }};
    const demo = {{ demo_allowed | json }} && new URLSearchParams(location.search).has('mc_demo');
    if (!signedIn && !demo) return;
    if (!signedIn) {
      root.querySelector('[data-mc-signed-out]')?.setAttribute('hidden', '');
      root.querySelector('[data-mc-app]').hidden = false;
    }

    const $ = (s) => root.querySelector(s);
    const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
    const money = (n) => `${Number(n) < 0 ? '-' : ''}$${Math.abs(Number(n) || 0).toFixed(2)}`;
    const dollars = (n) => `$${Number.isInteger(Number(n)) ? Number(n) : Number(n).toFixed(2)}`;
    const date = (iso) => (iso ? new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' }) : '');
    const ICON = {
      bag: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 8h14l-1 12H6zM9 8a3 3 0 0 1 6 0"/></svg>',
      cart: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 4h3l2.4 11h11L21 7H6.2"/><circle cx="9" cy="19.5" r="1.4"/><circle cx="17" cy="19.5" r="1.4"/></svg>',
      undo: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 5 4 10l5 5"/><path d="M4 10h10a6 6 0 0 1 0 12h-3"/></svg>',
      people: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="9" cy="8" r="3.4"/><circle cx="17" cy="9" r="2.8"/><path d="M2.5 20c.8-4 3.4-6 6.5-6s5.7 2 6.5 6M15 14.2c2.8 0 5 1.8 6 5"/></svg>',
      star: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m12 3 2.7 5.6 6.1.8-4.5 4.2 1.1 6.1L12 16.8l-5.4 2.9 1.1-6.1-4.5-4.2 6.1-.8z"/></svg>',
      gift: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="9" width="18" height="12"/><path d="M2 6h20v3H2zM12 6v15M12 6c-1-3-5-3-5 0M12 6c1-3 5-3 5 0"/></svg>',
      ticket: '<svg width="34" height="26" viewBox="0 0 34 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 5h30v4a3 3 0 0 0 0 6v4H2v-4a3 3 0 0 0 0-6z"/><path d="M17 7v2M17 11v2M17 15v2"/></svg>',
      link: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>',
      store: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 9 4.5 4h15L21 9M3 9v11h18V9M3 9h18M9 20v-6h6v6"/></svg>',
      check: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#164bff" stroke-width="2.4" aria-hidden="true"><path d="m4 12 5 5L20 6"/></svg>',
      reorder: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.3-5.7M20 4v5h-5"/></svg>',
    };
    // Hexagon tier badge: tier colours with the original CARBON mark (in white) inside.
    const TIER_COLORS = { bronze: ['#d4894e', '#9a5426'], silver: ['#c9ced6', '#7d8590'], gold: ['#e8c25a', '#a8801e'] };
    const MARK = {{ 'carbon-member-club-mark-white.png' | asset_url | json }};
    function badge(code) {
      const [a, b] = TIER_COLORS[String(code || '').toLowerCase()] || ['#5b6070', '#2a2d36'];
      return `<span class="mc-tier__badge" aria-hidden="true" style="background:linear-gradient(135deg, ${a}, ${b})"><img src="${MARK}" alt="" width="40" height="42"></span>`;
    }

    // ---------------- data ----------------
    const SAMPLE = {
      linked: true, balance: 202, preview: true,
      rules: { live: true, min_redeem_points: 100, redeem_increment_points: 100, redeem_points_per_dollar: 10, earn_rate_per_dollar: 1, max_redeem_dollars_per_order: 30, max_redeem_pct_of_order: 50 },
      tier: { code: 'bronze', name: 'Bronze', multiplier: 1, perks: ['Earn 1 point per $1 spent', 'Member-only drops and early access', 'Bigger rewards at higher tiers'], metric: 'amount', progress: 90, next: { name: 'Silver', needed: 410 } },
      referral: { url: 'https://shopcarbon.com/?ref=CARBON-SAMPLE', you_get: 200, friend_gets: 100, min_purchase: 60 },
      codes: [], thank_you_codes: [],
      activity: [
        { delta_points: 52, reason: 'sale', source: 'shopify', created_at: '2026-01-24T15:00:00Z' },
        { delta_points: 40, reason: 'sale', source: 'pos', created_at: '2026-01-20T15:00:00Z' },
        { delta_points: 200, reason: 'referral_bonus', source: 'system', created_at: '2026-01-15T15:00:00Z' },
        { delta_points: -56, reason: 'refund', source: 'pos', created_at: '2026-01-12T15:00:00Z' },
        { delta_points: 50, reason: 'signup_bonus', source: 'system', created_at: '2026-01-05T15:00:00Z' },
      ],
    };
    const SAMPLE_ORDERS = [{ id: 1, name: '#1079', at: '2026-01-24T15:00:00Z', cancelled_at: null, financial: 'paid', total: 35, items: 1, title: 'Sample item', lines: 1, image: null, url: '#', again: null }];
    const SAMPLE_PURCHASES = { store: [{ number: 'S-1001', points: 40, placed_at: '2026-01-20T15:00:00Z', total: 28, status: 'completed', store: 'Carbon Orlando', lines: [{ description: 'Sample item', quantity: 1, total: 28, type: 'product' }] }], online_points: { 1: 52 } };

    let orders = demo ? SAMPLE_ORDERS : [];
    try { if (!demo) orders = JSON.parse(document.getElementById('MemberClubOrders-{{ section.id }}')?.textContent || '[]'); } catch (e) { orders = []; }
    let summary = null;
    let purchases; // undefined = loading, null = failed
    let busy = 0;
    let showAllActivity = false;

    async function api(path, body) {
      const res = await fetch('/apps/loyalty/' + path, body
        ? { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body) }
        : { headers: { Accept: 'application/json' } });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw Object.assign(new Error(data.message || 'Something went wrong — please try again.'), { code: data.error });
      return data;
    }

    // ---------------- rules (mirrors the rewards server and the cart box) ----------------
    function options(s) {
      const r = s.rules; const step = r.redeem_increment_points;
      const max = Math.min(Math.floor((r.max_redeem_dollars_per_order * r.redeem_points_per_dollar) / step) * step, Math.floor(s.balance / step) * step);
      const out = [];
      for (let p = Math.max(step, r.min_redeem_points); p <= max; p += step) out.push({ points: p, dollars: p / r.redeem_points_per_dollar });
      return out;
    }
    const target = (t) => Number(t.progress) + Number(t.next.needed);
    function progressLabel(t) {
      const p = Math.floor(Number(t.progress)); const g = Math.ceil(target(t));
      if (t.metric === 'points') return `${p.toLocaleString()} / ${g.toLocaleString()} points to ${t.next.name}`;
      if (t.metric === 'visits') return `${p} / ${g} purchases toward ${t.next.name}`;
      return `$${p.toLocaleString()} / $${g.toLocaleString()} spent toward ${t.next.name}`;
    }
    function toNext(t) {
      const n = Math.ceil(Number(t.next.needed));
      if (t.metric === 'points') return `Earn ${n.toLocaleString()} more points to reach ${t.next.name}`;
      if (t.metric === 'visits') return `Make ${n} more ${n === 1 ? 'purchase' : 'purchases'} to reach ${t.next.name}`;
      return `Spend $${n.toLocaleString()} more to reach ${t.next.name}`;
    }
    function ends(t) {
      const p = Math.floor(Number(t.progress)); const g = Math.ceil(target(t));
      if (t.metric === 'points') return [`${p.toLocaleString()} points`, `${g.toLocaleString()} to ${t.next.name}`];
      if (t.metric === 'visits') return [`${p} ${p === 1 ? 'purchase' : 'purchases'}`, `${g} to ${t.next.name}`];
      return [`$${p.toLocaleString()} spent`, `$${g.toLocaleString()} to ${t.next.name}`];
    }
    const REASON = { sale: 'Purchase', redemption: 'Reward redeemed', refund: 'Refund', signup_bonus: 'Member sign up', birthday_bonus: 'Birthday bonus', referral_bonus: 'Referral reward', manual: 'Adjustment', adjustment: 'Adjustment', migration: 'Points transferred' };
    const ACT_ICON = { sale: 'bag', refund: 'undo', redemption: 'ticket', referral_bonus: 'people', signup_bonus: 'star', birthday_bonus: 'gift' };
    function actTitle(a) {
      if (a.source === 'system' && a.reason === 'adjustment') return 'Code cancelled or expired — points returned';
      const where = a.source === 'shopify' ? 'Online' : a.source === 'pos' ? 'In-store' : '';
      if ((a.reason === 'sale' || a.reason === 'refund') && where) return `${REASON[a.reason]} (${where})`;
      return REASON[a.reason] || 'Activity';
    }
    function orderStatus(o) {
      if (o.cancelled_at) return ['Canceled', 'mc-pill--bad'];
      if (o.financial === 'refunded') return ['Refunded', 'mc-pill--ok'];
      if (o.financial === 'partially_refunded') return ['Partly refunded', 'mc-pill--ok'];
      if (o.financial === 'voided') return ['Voided', 'mc-pill--bad'];
      if (o.financial === 'pending' || o.financial === 'authorized') return ['Payment pending', ''];
      return null;
    }
    const pill = (s) => (s ? `<span class="mc-pill ${s[1]}">${esc(s[0])}</span>` : '');
    const orderPoints = (o) => purchases?.online_points?.[String(o.id)] ?? null;
    const orderTitle = (o) => `${o.title || `Order ${o.name}`}${o.lines > 1 ? ` + ${o.lines - 1} more` : ''}`;
    const storeTitle = (p) => {
      const items = p.lines.filter((l) => l.type !== 'loyalty_redemption');
      return items[0] ? `${items[0].description}${items.length > 1 ? ` + ${items.length - 1} more` : ''}` : 'In-store purchase';
    };

    // ---------------- render ----------------
    function renderRewards() {
      const s = summary;
      const banners = $('[data-mc-banners]');
      if (!s) return;
      const opts = options(s);
      const step = s.rules.redeem_increment_points;
      const stepDollars = step / s.rules.redeem_points_per_dollar;
      $('[data-mc-balance]').textContent = Number(s.balance || 0).toLocaleString();
      $('[data-mc-upto]').textContent = opts.length
        ? `Up to ${dollars(opts[opts.length - 1].dollars)} off your next purchase`
        : `${Math.max(1, step - s.balance)} more points to unlock ${dollars(stepDollars)} off`;

      let b = '';
      if (s.preview) b += `<div class="mc-banner">Sample data for design review — members see their own points and purchases.</div>`;
      for (const c of s.thank_you_codes || []) {
        b += `<div class="mc-banner"><strong>${esc(c.percent_off)}% off your next order</strong> — thank you for order ${esc(c.order_name)} · one use · valid until ${esc(date(c.ends_at))}${codeRow(c.code)}</div>`;
      }
      banners.innerHTML = b;

      // Tier
      const t = s.tier;
      $('[data-mc-tier]').innerHTML = t
        ? `<div class="mc-tier__head">${badge(t.code)}<div><p class="mc-tier__name">${esc(t.name)} Tier</p><p class="mc-tier__sub">Current tier</p></div></div>
           <div>${t.next
              ? `<p class="mc-desk-text" style="margin:0;font-size:20px">${esc(progressLabel(t))}</p>
                 <p class="mc-phone-text" style="font-weight:400;font-size:18px">${esc(toNext(t))}</p>
                 ${target(t) > 0 && Number(t.progress) >= 0 ? `<div class="mc-bar" role="progressbar" aria-label="Progress to ${esc(t.next.name)}" aria-valuemin="0" aria-valuemax="${Math.ceil(target(t))}" aria-valuenow="${Math.floor(Number(t.progress))}"><i style="width:${Math.min(100, (Number(t.progress) / target(t)) * 100).toFixed(1)}%"></i></div>` : ''}
                 <div class="mc-ends"><span>${esc(ends(t)[0])}</span><span>${esc(ends(t)[1])}</span></div>`
              : `<p style="margin:0;font-size:18px">You're at our top tier — thank you!</p>`}
             ${t.perks?.length ? `<ul class="mc-perks">${t.perks.map((p) => `<li>${ICON.check}${esc(p)}</li>`).join('')}</ul>` : ''}
           </div>`
        : '';

      // Redeem / active code
      const r = $('[data-mc-redeem]');
      if (s.codes?.length) {
        r.innerHTML = s.codes.map((c) => `<div class="mc-card"><strong>Your ${dollars(c.dollars)} code is ready</strong>
            <p class="mc-meta">For items totaling ${dollars(c.min_subtotal)} or more · shipping not included · expires ${esc(date(c.expires_at))}</p>
            ${codeRow(c.code, true)}
            <p class="mc-note">One code at a time. <button type="button" class="mc-link" data-cancel="${esc(c.code)}">Cancel code &amp; return ${esc(c.points)} points</button></p></div>`).join('');
      } else if (s.rules.live && opts.length) {
        r.innerHTML = `<div class="mc-btns">${opts.map((o, i) => `<button type="button" class="mc-btn ${i === 0 ? 'mc-btn--fill' : ''}" data-redeem="${o.points}" ${busy ? 'disabled' : ''} aria-label="Redeem ${dollars(o.dollars)} off for ${o.points} points">
              <span class="mc-redeem__icon">${ICON.ticket}</span>
              <span class="mc-desk-text"><span class="mc-btn__big">${busy === o.points ? 'Getting your code…' : `Redeem ${dollars(o.dollars)} off`}</span><span class="mc-btn__small">${o.points} points</span></span>
              <span class="mc-phone-text">${busy === o.points ? 'Getting code…' : `${dollars(o.dollars)} off / ${o.points} points`}</span>
            </button>`).join('')}</div>
            <p class="mc-note mc-desk-text">One-time code · up to ${dollars(s.rules.max_redeem_dollars_per_order)} off per purchase</p>`;
      } else {
        r.innerHTML = '';
      }

      // Referral
      const ref = $('[data-mc-refer]');
      if (s.referral) {
        ref.hidden = false;
        ref.innerHTML = `<span style="color:var(--mc-blue)">${ICON.people.replace('width="26" height="26"', 'width="48" height="48"')}</span>
          <div><h3><span class="mc-desk-text">Refer a friend. Earn ${esc(s.referral.you_get)} points.</span><span class="mc-phone-text" style="font-size:22px">Refer a friend</span></h3>
          <p>Your friend earns ${esc(s.referral.friend_gets)} points, and you earn ${esc(s.referral.you_get)} points after their first ${dollars(s.referral.min_purchase)}+ purchase.</p>
          <p class="mc-status" data-mc-ref-status role="status"></p></div>
          <button type="button" class="mc-btn" data-share>${ICON.link}<span class="mc-desk-text">Get referral link</span><span class="mc-phone-text">Refer a friend</span></button>`;
      } else ref.hidden = true;

      // Activity
      const act = s.activity || [];
      const shown = showAllActivity ? act : act.slice(0, window.matchMedia('(max-width: 899px)').matches ? 3 : 4);
      $('[data-mc-activity]').innerHTML = `<div class="mc-head"><h3>Points activity</h3>${act.length > shown.length || showAllActivity ? `<button type="button" class="mc-link" data-more>${showAllActivity ? 'Show less' : 'View all →'}</button>` : ''}</div>
        <div class="mc-card mc-rows" style="padding:4px 18px">${act.length ? shown.map((a) => `<div class="mc-row">${ICON[ACT_ICON[a.reason] || 'star']}
          <div><strong>${esc(actTitle(a))}</strong><small>${esc(date(a.created_at))}</small></div>
          <span class="mc-pts ${a.delta_points < 0 ? 'mc-pts--neg' : ''}">${a.delta_points > 0 ? '+' : ''}${esc(a.delta_points)} <span class="mc-unit-desk">pts</span><span class="mc-unit-phone">points</span></span></div>`).join('') : '<p class="mc-empty">No points activity yet.</p>'}</div>`;
    }

    function codeRow(code, withCart) {
      return `<div class="mc-code"><code>${esc(code)}</code><button type="button" class="mc-btn" data-copy="${esc(code)}">Copy code</button>${withCart ? `<button type="button" class="mc-btn mc-btn--fill" data-apply="${esc(code)}">Apply to my cart</button>` : ''}<span class="mc-status" role="status"></span></div>`;
    }

    function renderPurchases() {
      const latest = orders[0];
      const storeList = Array.isArray(purchases?.store) ? purchases.store : [];
      const receipt = storeList[0];
      const storeFailed = purchases === null;

      $('[data-mc-recent]').innerHTML = `<div class="mc-head"><h3>Recent purchases</h3><button type="button" class="mc-link" data-tab="purchases">View all purchases →</button></div>
        ${latest ? `<div class="mc-buy"><a class="mc-thumb" href="${esc(latest.url)}" style="${latest.image ? `background-image:url('${esc(latest.image)}')` : ''}" aria-label="Order ${esc(latest.name)}">${latest.image ? '' : ICON.bag}</a>
          <div><strong style="font-size:20px">Order ${esc(latest.name)}</strong> ${pill(orderStatus(latest))}
          <p class="mc-meta">${esc(latest.items)} ${latest.items === 1 ? 'item' : 'items'} · ${money(latest.total)}</p>
          <p class="mc-meta">Placed ${esc(date(latest.at))}${latest.cancelled_at ? ` · Canceled ${esc(date(latest.cancelled_at))}` : ''}</p></div>
          ${latest.again ? `<a class="mc-btn" href="${esc(latest.again)}">${ICON.reorder}Buy again</a>` : `<a class="mc-btn" href="${esc(latest.url)}">View order</a>`}</div>`
        : '<p class="mc-empty">No online orders yet.</p>'}`;

      $('[data-mc-store]').innerHTML = `<div class="mc-head"><h3>In-store receipt${receipt?.status === 'refunded' ? ' (refund)' : ''}</h3></div>
        ${purchases === undefined ? '<div class="mc-skel"></div>' : storeFailed ? '<p class="mc-empty">In-store purchases can\'t be shown right now.</p>'
        : receipt ? `<div class="mc-buy" style="grid-template-columns:auto minmax(0,1fr)"><span class="mc-thumb mc-thumb--sm">${ICON.store}</span>
          <div><strong>${esc(receipt.store || 'Carbon store')} — In-store purchase</strong>
          <p class="mc-meta">${esc(storeTitle(receipt))} · ${money(receipt.total)}</p>
          <p class="mc-meta">Purchased ${esc(date(receipt.placed_at))}${receipt.status === 'refunded' ? ' · <span class="mc-pill mc-pill--ok">Refunded</span>' : ''}</p></div></div>`
        : '<p class="mc-empty">No in-store purchases yet.</p>'}`;

      // Phone: one list, newest first.
      const merged = [
        ...orders.map((o) => ({ at: o.at, title: orderTitle(o), where: 'Online', total: o.total, image: o.image, href: o.url, points: orderPoints(o), status: orderStatus(o) })),
        ...storeList.map((p) => ({ at: p.placed_at, title: storeTitle(p), where: 'In-store', total: p.total, image: null, href: null, points: p.points, status: p.status === 'refunded' ? ['Refunded', 'mc-pill--ok'] : null })),
      ].sort((a, b) => new Date(b.at) - new Date(a.at)).slice(0, 3);
      $('[data-mc-plist]').innerHTML = `<div class="mc-head"><h3>Recent purchases</h3><button type="button" class="mc-link" data-tab="purchases">View all</button></div>
        <div class="mc-rows">${merged.length ? merged.map(purchaseRow).join('') : purchases === undefined ? '<div class="mc-skel"></div>' : '<p class="mc-empty">No purchases yet.</p>'}</div>
        ${storeFailed ? '<p class="mc-note">In-store purchases can\'t be shown right now.</p>' : ''}`;

      // Purchases tab
      $('[data-mc-online-all]').innerHTML = orders.length
        ? orders.map((o) => `${purchaseRow({ at: o.at, title: orderTitle(o), where: `Online · Order ${o.name}`, total: o.total, image: o.image, href: o.url, points: orderPoints(o), status: orderStatus(o), again: o.again })}`).join('')
        : '<p class="mc-empty">No online orders yet.</p>';
      $('[data-mc-store-all]').innerHTML = purchases === undefined ? '<div class="mc-skel"></div>' : storeFailed
        ? '<p class="mc-empty">In-store purchases can\'t be shown right now. Please try again later.</p>'
        : storeList.length ? storeList.map((p) => `<div style="padding:14px 2px">
            <div class="mc-head" style="margin:0 0 6px"><strong>${esc(date(p.placed_at))} · ${esc(p.store || 'Carbon store')} ${p.status === 'refunded' ? '<span class="mc-pill mc-pill--ok">Refunded</span>' : ''}</strong>${p.points ? `<span class="mc-pts">+${esc(p.points)} points</span>` : ''}</div>
            ${p.lines.map((l) => `<div class="mc-head" style="margin:0;font-size:15px"><span${l.type === 'loyalty_redemption' ? ' class="mc-empty"' : ''}>${l.type === 'loyalty_redemption' ? 'Carbon Rewards' : esc(l.description)}${l.quantity > 1 ? ` × ${esc(l.quantity)}` : ''}</span><span>${money(l.total)}</span></div>`).join('')}
            <div class="mc-head" style="margin:6px 0 0"><strong>Total · Receipt ${esc(p.number)}</strong><strong>${money(p.total)}</strong></div></div>`).join('')
        : '<p class="mc-empty">No in-store purchases yet. Give your phone number or email at checkout to see them here.</p>';
    }

    function purchaseRow(p) {
      const thumb = p.image ? `<span class="mc-thumb mc-thumb--sm" style="background-image:url('${esc(p.image)}')"></span>` : `<span class="mc-thumb mc-thumb--sm">${p.where.startsWith('In-store') ? ICON.store : ICON.bag}</span>`;
      const body = `<div><strong>${esc(p.title)}</strong><small>${esc(p.where)} · ${esc(date(p.at))}</small><div>${money(p.total)} ${pill(p.status)}</div>
        ${p.again ? `<a class="mc-link" href="${esc(p.again)}">Buy again</a>` : ''}</div>`;
      return `<div class="mc-row" style="grid-template-columns:72px minmax(0,1fr) auto">${p.href ? `<a href="${esc(p.href)}" aria-label="View ${esc(p.title)}">${thumb}</a>` : thumb}${body}
        <span class="mc-pts">${p.points ? `+${esc(p.points)} points` : ''}</span></div>`;
    }

    // ---------------- actions ----------------
    function setTab(tab) {
      for (const b of root.querySelectorAll('.mc__nav button, .mc__tabs button')) {
        if (b.dataset.tab === tab) b.setAttribute('aria-current', 'page');
        else b.removeAttribute('aria-current');
      }
      for (const p of root.querySelectorAll('[data-panel]')) p.hidden = p.dataset.panel !== tab;
      history.replaceState(null, '', tab === 'rewards' ? location.pathname + location.search : `#${tab}`);
    }

    async function copy(text, status) {
      try {
        await navigator.clipboard.writeText(text);
        status.textContent = 'Copied';
        status.classList.remove('mc-status--err');
      } catch (e) {
        status.textContent = `Couldn't copy — select it: ${text}`;
        status.classList.add('mc-status--err');
      }
    }

    root.addEventListener('click', async (e) => {
      const t = e.target.closest('button, a');
      if (!t || !root.contains(t)) return;
      if (t.dataset.tab) { e.preventDefault(); setTab(t.dataset.tab); window.scrollTo({ top: root.offsetTop - 80 }); return; }
      if (t.dataset.more !== undefined) { showAllActivity = !showAllActivity; renderRewards(); return; }
      if (t.dataset.copy) { copy(t.dataset.copy, t.parentElement.querySelector('.mc-status')); return; }
      if (t.dataset.apply) {
        const status = t.parentElement.querySelector('.mc-status');
        try {
          if (!window.CarbonRewards) throw new Error();
          await window.CarbonRewards.setRewardCode(await window.CarbonRewards.getCart(), t.dataset.apply);
          status.textContent = 'Added to your cart';
        } catch (err) { status.textContent = 'Copy the code and enter it at checkout instead.'; status.classList.add('mc-status--err'); }
        return;
      }
      if (t.dataset.share !== undefined) {
        const url = summary.referral.url; const status = $('[data-mc-ref-status]');
        if (navigator.share && window.matchMedia('(max-width: 899px)').matches) {
          try { await navigator.share({ title: 'Carbon', text: 'Shop Carbon with my link:', url }); return; } catch (err) { /* cancelled → copy instead */ }
        }
        copy(url, status);
        return;
      }
      if (t.dataset.redeem) {
        if (busy || demo) { if (demo) alert('Redeeming is off in the sample preview.'); return; }
        busy = Number(t.dataset.redeem); renderRewards();
        try {
          await api('redeem', { points: busy });
          summary = await api('balance');
        } catch (err) { showError(err.message); }
        busy = 0; renderRewards();
        return;
      }
      if (t.dataset.cancel) {
        if (demo) return;
        t.disabled = true;
        try { await api('cancel', { code: t.dataset.cancel }); } catch (err) { showError(err.message); }
        summary = await api('balance').catch(() => summary);
        renderRewards();
      }
    });

    function showError(msg) {
      const b = $('[data-mc-banners]');
      b.insertAdjacentHTML('afterbegin', `<div class="mc-banner mc-banner--err" role="alert">${esc(msg)}</div>`);
    }

    // ---------------- load ----------------
    if (location.hash === '#purchases' || location.hash === '#settings') setTab(location.hash.slice(1));
    renderPurchases();
    if (demo) {
      summary = SAMPLE; purchases = SAMPLE_PURCHASES; renderRewards(); renderPurchases();
      return;
    }
    api('balance')
      .then((s) => {
        summary = s;
        if (!s.linked) {
          $('[data-mc-banners]').innerHTML = '<div class="mc-banner">Your points will appear here after your first purchase online or in store.</div>';
          s.balance = s.balance ?? 0;
        }
        renderRewards();
      })
      .catch((err) => showError(err.code === 'not_logged_in' ? 'Please sign in again to see your points.' : "We couldn't load your rewards right now. Please refresh in a moment."));
    api('purchases')
      .then((p) => { purchases = p; })
      .catch(() => { purchases = null; })
      .finally(renderPurchases);
  })();
</script>

