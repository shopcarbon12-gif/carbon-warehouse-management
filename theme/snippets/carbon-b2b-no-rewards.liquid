{%- comment -%}
  Shown to wholesale (B2B) buyers in place of the rewards, Member Club and
  rewards-account pages (theme.liquid). Rewards, points, referral and retail
  offers are for retail customers only (owner 2026-11-07).
{%- endcomment -%}
<div class="page-width carbon-b2b-no-rewards">
  <h1>{{ 'carbon.b2b.wholesale_account' | t }}</h1>
  <p>{{ 'carbon.b2b.no_rewards_text' | t }}</p>
  <p>
    <a class="button" href="{{ routes.account_url }}">{{ 'carbon.b2b.your_orders' | t }}</a>
    <a class="button button--outline" href="{{ routes.all_products_collection_url }}">{{ 'carbon.b2b.shop_wholesale' | t }}</a>
  </p>
</div>
<style>
  .carbon-b2b-no-rewards { max-width: 640px; margin: 60px auto; padding: 0 16px; text-align: center; }
  .carbon-b2b-no-rewards p { margin: 0 0 20px; }
  .carbon-b2b-no-rewards .button { margin: 4px; }
</style>
