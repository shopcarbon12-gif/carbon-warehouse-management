<script>
(function () {
  var root = document.getElementById("carbon-size-guide-mens-tshirt-super-slim");
  if (!root || root.dataset.csgReady) return;
  root.dataset.csgReady = "1";

  var KEYS = ["chest", "shoulder", "sleeve", "length"];
  var unit = "in";
  var selected = "M";
  var rows = [].slice.call(root.querySelectorAll("[data-csg-row]"));
  var buttons = [].slice.call(root.querySelectorAll("[data-csg-size]"));
  var units = [].slice.call(root.querySelectorAll("[data-csg-unit]"));

  /* Centimetres are the only stored figures; inches are derived here so the two
     can never disagree. One decimal, and 28.0 keeps its zero so the column of
     numbers stays aligned. */
  function show(cm) {
    if (cm == null || cm === "") return "\u2014";
    if (unit === "cm") return String(parseFloat(cm));
    return (parseFloat(cm) / 2.54).toFixed(1);
  }

  function rowFor(size) {
    for (var i = 0; i < rows.length; i++) {
      if (rows[i].getAttribute("data-csg-row") === size) return rows[i];
    }
    return null;
  }

  function paint() {
    rows.forEach(function (tr) {
      KEYS.forEach(function (k) {
        var td = tr.querySelector('[data-csg-cell="' + k + '"]');
        if (td) td.textContent = show(tr.getAttribute("data-cm-" + k));
      });
      tr.setAttribute("aria-selected", tr.getAttribute("data-csg-row") === selected ? "true" : "false");
    });
    buttons.forEach(function (b) {
      b.setAttribute("aria-pressed", b.getAttribute("data-csg-size") === selected ? "true" : "false");
    });
    units.forEach(function (b) {
      b.setAttribute("aria-pressed", b.getAttribute("data-csg-unit") === unit ? "true" : "false");
    });
    root.querySelectorAll("[data-csg-unitlabel]").forEach(function (el) {
      el.textContent = "(" + unit + ")";
    });
    var tr = rowFor(selected);
    var label = root.querySelector("[data-csg-sel-size]");
    if (label) label.textContent = selected;
    KEYS.forEach(function (k) {
      var el = root.querySelector('[data-csg-sel="' + k + '"]');
      if (!el) return;
      el.innerHTML = tr
        ? show(tr.getAttribute("data-cm-" + k)) + '<span class="csg-sel-u">' + unit + "</span>"
        : "\u2014";
    });
  }

  function select(size) { selected = size; paint(); }

  rows.forEach(function (tr) {
    tr.addEventListener("click", function () { select(tr.getAttribute("data-csg-row")); });
    tr.addEventListener("keydown", function (e) {
      if (e.key === "Enter" || e.key === " ") { e.preventDefault(); select(tr.getAttribute("data-csg-row")); }
    });
  });
  buttons.forEach(function (b) {
    b.addEventListener("click", function () { select(b.getAttribute("data-csg-size")); });
  });
  units.forEach(function (b) {
    b.addEventListener("click", function () { unit = b.getAttribute("data-csg-unit"); paint(); });
  });

  paint();
})();
</script>
