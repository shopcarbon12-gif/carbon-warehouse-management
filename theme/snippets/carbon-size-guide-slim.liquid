d="false" tabindex="0"><th scope="row">33</th><td data-csg-cell="waist">34.5</td><td data-csg-cell="hip">41.5</td><td data-csg-cell="inseam">32</td></tr><tr data-csg-row="34" data-in-waist="35.5" data-in-hip="42.5" data-in-inseam="32" data-cm-waist="90" data-cm-hip="108" data-cm-inseam="81" aria-selected="false" tabindex="0"><th scope="row">34</th><td data-csg-cell="waist">35.5</td><td data-csg-cell="hip">42.5</td><td data-csg-cell="inseam">32</td></tr><tr data-csg-row="36" data-in-waist="37.5" data-in-hip="44.5" data-in-inseam="32" data-cm-waist="95" data-cm-hip="113" data-cm-inseam="81" aria-selected="false" tabindex="0"><th scope="row">36</th><td data-csg-cell="waist">37.5</td><td data-csg-cell="hip">44.5</td><td data-csg-cell="inseam">32</td></tr><tr data-csg-row="38" data-in-waist="39.5" data-in-hip="46.5" data-in-inseam="32" data-cm-waist="100" data-cm-hip="118" data-cm-inseam="81" aria-selected="false" tabindex="0"><th scope="row">38</th><td data-csg-cell="waist">39.5</td><td data-csg-cell="hip">46.5</td><td data-csg-cell="inseam">32</td></tr></tbody>
