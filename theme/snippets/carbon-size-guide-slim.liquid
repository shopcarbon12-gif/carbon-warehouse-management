
<!-- CARBON interactive Shopify size guide: Slim Fit Jeans -->
<div id="carbon-size-guide-slim" class="carbon-size-guide" data-fit="slim">
  <div class="csg-shell">
    <header class="csg-header">
      <div>
        <p class="csg-kicker">Carbon — Size Guide</p>
        <h2 class="csg-title">Slim Fit Jeans Size Guide</h2>
        <div class="csg-blue-rule" aria-hidden="true"></div>
        <p class="csg-subtitle">The roomiest of the four — the fullest thigh and the widest leg opening.</p>
      </div>
    </header>

    <div class="csg-topgrid">
      <section class="csg-card" aria-label="Find your size">
        <div class="csg-card-head">
          <h3 class="csg-h2">Find Your Size</h3>
          <div class="csg-unit-toggle" role="group" aria-label="Measurement units">
            <button type="button" data-csg-unit="in" aria-pressed="true">IN</button>
            <button type="button" data-csg-unit="cm" aria-pressed="false">CM</button>
          </div>
        </div>
        <div class="csg-table-wrap">
          <table>
            <thead>
              <tr><th scope="col">Size</th><th scope="col" data-csg-measure-head data-csg-label="Waist">Waist (in)</th><th scope="col" data-csg-measure-head data-csg-label="Hip">Hip (in)</th><th scope="col" data-csg-measure-head data-csg-label="Inseam">Inseam (in)</th></tr>
            </thead>
            <tbody>
              <tr data-csg-row="27" data-in-waist="28.5" data-in-hip="35.5" data-in-inseam="29" data-cm-waist="73" data-cm-hip="90" data-cm-inseam="74" aria-selected="false">
                <th scope="row">27</th><td data-csg-cell="waist">28.5</td><td data-csg-cell="hip">35.5</td><td data-csg-cell="inseam">29</td>
              </tr>
              <tr data-csg-row="28" data-in-waist="29.5" data-in-hip="36.5" data-in-inseam="30" data-cm-waist="75" data-cm-hip="93" data-cm-inseam="76" aria-selected="false">
                <th scope="row">28</th><td data-csg-cell="waist">29.5</td><td data-csg-cell="hip">36.5</td><td data-csg-cell="inseam">30</td>
              </tr>
              <tr data-csg-row="29" data-in-waist="30.5" data-in-hip="37.5" data-in-inseam="30" data-cm-waist="77" data-cm-hip="95" data-cm-inseam="76" aria-selected="false">
                <th scope="row">29</th><td data-csg-cell="waist">30.5</td><td data-csg-cell="hip">37.5</td><td data-csg-cell="inseam">30</td>
              </tr>
              <tr data-csg-row="30" data-in-waist="31.5" data-in-hip="38.5" data-in-inseam="30" data-cm-waist="80" data-cm-hip="98" data-cm-inseam="76" aria-selected="false">
                <th scope="row">30</th><td data-csg-cell="waist">31.5</td><td data-csg-cell="hip">38.5</td><td data-csg-cell="inseam">30</td>
              </tr>
              <tr data-csg-row="31" data-in-waist="32.5" data-in-hip="39.5" data-in-inseam="30" data-cm-waist="82" data-cm-hip="100" data-cm-inseam="76" aria-selected="false">
                <th scope="row">31</th><td data-csg-cell="waist">32.5</td><td data-csg-cell="hip">39.5</td><td data-csg-cell="inseam">30</td>
              </tr>
              <tr data-csg-row="32" data-in-waist="33.5" data-in-hip="40.5" data-in-inseam="32" data-cm-waist="85" data-cm-hip="103" data-cm-inseam="81" aria-selected="false">
                <th scope="row">32</th><td data-csg-cell="waist">33.5</td><td data-csg-cell="hip">40.5</td><td data-csg-cell="inseam">32</td>
              </tr>
              <tr data-csg-row="33" data-in-waist="34.5" data-in-hip="41.5" data-in-inseam="32" data-cm-waist="88" data-cm-hip="105" data-cm-inseam="81" aria-selected="false">
                <th scope="row">33</th><td data-csg-cell="waist">34.5</td><td data-csg-cell="hip">41.5</td><td data-csg-cell="inseam">32</td>
              </tr>
              <tr data-csg-row="34" data-in-waist="35.5" data-in-hip="42.5" data-in-inseam="32" data-cm-waist="90" data-cm-hip="108" data-cm-inseam="81" aria-selected="false">
                <th scope="row">34</th><td data-csg-cell="waist">35.5</td><td data-csg-cell="hip">42.5</td><td data-csg-cell="inseam">32</td>
              </tr>
              <tr data-csg-row="36" data-in-waist="37.5" data-in-hip="44.5" data-in-inseam="32" data-cm-waist="95" data-cm-hip="113" data-cm-inseam="81" aria-selected="false">
                <th scope="row">36</th><td data-csg-cell="waist">37.5</td><td data-csg-cell="hip">44.5</td><td data-csg-cell="inseam">32</td>
              </tr>
              <tr data-csg-row="38" data-in-waist="39.5" data-in-hip="46.5" data-in-inseam="32" data-cm-waist="100" data-cm-hip="118" data-cm-inseam="81" aria-selected="false">
                <th scope="row">38</th><td data-csg-cell="waist">39.5</td><td data-csg-cell="hip">46.5</td><td data-csg-cell="inseam">32</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="csg-table-note" data-csg-table-note>Garment measurements shown in inches. Waist and hip are measured flat and doubled.</p>
      </section>

      <aside class="csg-side" aria-label="Size selection and helpful note">
        <section class="csg-card">
          <h3 class="csg-h2">Select a Size</h3>
          <div class="csg-size-buttons" role="group" aria-label="Choose a size">
            <button type="button" class="csg-size-btn" data-csg-size="27" aria-pressed="false">27</button>
            <button type="button" class="csg-size-btn" data-csg-size="28" aria-pressed="false">28</button>
            <button type="button" class="csg-size-btn" data-csg-size="29" aria-pressed="false">29</button>
            <button type="button" class="csg-size-btn" data-csg-size="30" aria-pressed="false">30</button>
            <button type="button" class="csg-size-btn" data-csg-size="31" aria-pressed="false">31</button>
            <button type="button" class="csg-size-btn" data-csg-size="32" aria-pressed="false">32</button>
            <button type="button" class="csg-size-btn" data-csg-size="33" aria-pressed="false">33</button>
            <button type="button" class="csg-size-btn" data-csg-size="34" aria-pressed="false">34</button>
            <button type="button" class="csg-size-btn" data-csg-size="36" aria-pressed="false">36</button>
            <button type="button" class="csg-size-btn" data-csg-size="38" aria-pressed="false">38</button>
          </div>
          <div class="csg-selected-label" data-csg-selected-label aria-live="polite">Click any size to highlight its measurements.</div>
        </section>
        <div class="csg-help" role="note">
          <div class="csg-help-icon" aria-hidden="true">i</div>
          <div><strong>Helpful note:</strong> Garment measurements can vary slightly from pair to pair due to normal production and finishing. Please allow approximately <strong>±2 cm (±1 in)</strong>. If you’re between sizes, compare these measurements with a pair of jeans you already own and love.</div>
        </div>
      </aside>
    </div>

    <section class="csg-section" aria-label="How to measure at home">
      <div class="csg-section-head"><h3 class="csg-h2">How to Measure at Home</h3></div>
      
<div class="csg-measure-grid">
  <article class="csg-measure-card">
    <div class="csg-measure-title"><span class="csg-step">1</span><span>Waist</span></div>
    <figure class="csg-measure-figure" aria-label="Waist measurement diagram">
      <svg viewBox="0 0 420 280" role="img" aria-labelledby="csg-waist-title-slim">
        <title id="csg-waist-title-slim">Measure straight across the top waistband from edge to edge, then double it</title>
        <defs>
          <linearGradient id="denimWaist-slim" x1="0" x2="1"><stop offset="0" stop-color="#1a2a45"/><stop offset="1" stop-color="#243d65"/></linearGradient>
          <marker id="arrowWaist-slim" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 Z" fill="#0067ff"/></marker>
        </defs>
        <rect x="26" y="55" width="368" height="175" rx="18" fill="#f4f7fb"/>
        <path d="M75 105 L345 105 L330 228 L90 228 Z" fill="url(#denimWaist-slim)"/>
        <path d="M82 118 L338 118" stroke="#d6a85e" stroke-width="3" stroke-dasharray="9 7"/>
        <rect x="198" y="104" width="24" height="24" rx="12" fill="#d9dde4" stroke="#111827" stroke-width="2"/>
        <path d="M100 133 Q135 155 170 137 M250 137 Q285 155 320 133" fill="none" stroke="#7f96b9" stroke-width="3" opacity=".6"/>
        <line x1="82" y1="79" x2="338" y2="79" stroke="#0067ff" stroke-width="6" marker-start="url(#arrowWaist-slim)" marker-end="url(#arrowWaist-slim)"/>
        <line x1="82" y1="84" x2="82" y2="105" stroke="#0067ff" stroke-width="3"/>
        <line x1="338" y1="84" x2="338" y2="105" stroke="#0067ff" stroke-width="3"/>
        <g font-family="Arial, sans-serif" font-weight="700" fill="#0067ff" font-size="16">
          <text x="60" y="48">START AT EDGE</text><text x="279" y="48">END AT EDGE</text>
        </g>
      </svg>
    </figure>
    <p><strong>Measure straight across the top waistband</strong> from edge to edge, then double it.</p>
    <div class="csg-mini-note">Button and zip the jeans first.</div>
  </article>

  <article class="csg-measure-card">
    <div class="csg-measure-title"><span class="csg-step">2</span><span>Hip</span></div>
    <figure class="csg-measure-figure" aria-label="Hip measurement diagram">
      <svg viewBox="0 0 420 280" role="img" aria-labelledby="csg-hip-title-slim">
        <title id="csg-hip-title-slim">Measure across the widest point about 16 centimetres or 6.3 inches below the waistband, then double it</title>
        <defs>
          <linearGradient id="denimHip-slim" x1="0" x2="1"><stop offset="0" stop-color="#1a2a45"/><stop offset="1" stop-color="#243d65"/></linearGradient>
          <marker id="arrowHip-slim" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 Z" fill="#0067ff"/></marker>
        </defs>
        <rect x="26" y="30" width="368" height="210" rx="18" fill="#f4f7fb"/>
        <path d="M78 58 L342 58 L350 216 L260 216 L210 169 L160 216 L70 216 Z" fill="url(#denimHip-slim)"/>
        <path d="M83 72 L337 72" stroke="#d6a85e" stroke-width="3" stroke-dasharray="9 7"/>
        <path d="M108 87 Q142 113 177 91 M243 91 Q278 113 312 87" fill="none" stroke="#7f96b9" stroke-width="3" opacity=".6"/>
        <line x1="72" y1="163" x2="348" y2="163" stroke="#0067ff" stroke-width="6" marker-start="url(#arrowHip-slim)" marker-end="url(#arrowHip-slim)"/>
        <line x1="210" y1="77" x2="210" y2="150" stroke="#0067ff" stroke-width="3" stroke-dasharray="7 7" marker-end="url(#arrowHip-slim)"/>
        <rect x="226" y="96" width="158" height="46" rx="10" fill="#0067ff"/>
        <text x="305" y="115" text-anchor="middle" fill="#fff" font-family="Arial, sans-serif" font-weight="700" font-size="15">16 CM / 6.3 IN</text>
        <text x="305" y="133" text-anchor="middle" fill="#fff" font-family="Arial, sans-serif" font-weight="700" font-size="14">BELOW WAISTBAND</text>
        <text x="210" y="190" text-anchor="middle" fill="#fff" font-family="Arial, sans-serif" font-weight="700" font-size="15">WIDEST POINT</text>
      </svg>
    </figure>
    <p>Measure across the <strong>widest point, about 16 cm / 6.3 in below the waistband</strong>, then double it.</p>
    <div class="csg-mini-note">Keep the tape straight — not angled.</div>
  </article>

  <article class="csg-measure-card csg-inseam-card">
    <div class="csg-measure-title"><span class="csg-step">3</span><span>Inseam</span></div>
    <figure class="csg-measure-figure csg-inseam-figure" aria-label="Full inseam measurement diagram">
      <svg viewBox="0 0 420 560" role="img" aria-labelledby="csg-inseam-title-slim">
        <title id="csg-inseam-title-slim">Measure the full inseam from the crotch seam all the way to the hem</title>
        <defs>
          <linearGradient id="denimInseam-slim" x1="0" x2="1"><stop offset="0" stop-color="#17263f"/><stop offset="1" stop-color="#29466f"/></linearGradient>
          <marker id="arrowInseam-slim" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 Z" fill="#0067ff"/></marker>
        </defs>
        <rect x="38" y="18" width="344" height="525" rx="20" fill="#f4f7fb"/>
        <path d="M116 64 L304 64 L319 160 L278 515 L218 515 L210 211 L202 515 L142 515 L101 160 Z" fill="url(#denimInseam-slim)"/>
        <path d="M121 82 L299 82" stroke="#d6a85e" stroke-width="3" stroke-dasharray="9 7"/>
        <path d="M148 98 Q170 120 192 102 M228 102 Q250 120 272 98" fill="none" stroke="#7f96b9" stroke-width="3" opacity=".55"/>
        <path d="M210 84 L210 178" stroke="#9eb2cf" stroke-width="3"/>
        <circle cx="210" cy="181" r="7" fill="#0067ff"/>
        <line x1="228" y1="184" x2="228" y2="500" stroke="#0067ff" stroke-width="7" marker-start="url(#arrowInseam-slim)" marker-end="url(#arrowInseam-slim)"/>
        <line x1="222" y1="184" x2="198" y2="184" stroke="#0067ff" stroke-width="3"/>
        <line x1="222" y1="500" x2="217" y2="500" stroke="#0067ff" stroke-width="3"/>
        <rect x="244" y="155" width="137" height="48" rx="11" fill="#0067ff"/>
        <text x="312" y="175" text-anchor="middle" fill="#fff" font-family="Arial, sans-serif" font-weight="700" font-size="15">FROM CROTCH</text>
        <text x="312" y="193" text-anchor="middle" fill="#fff" font-family="Arial, sans-serif" font-weight="700" font-size="15">SEAM</text>
        <path d="M244 181 L218 181" stroke="#0067ff" stroke-width="4"/>
        <rect x="244" y="475" width="112" height="40" rx="10" fill="#0067ff"/>
        <text x="300" y="500" text-anchor="middle" fill="#fff" font-family="Arial, sans-serif" font-weight="700" font-size="15">TO HEM</text>
        <path d="M244 495 L228 500" stroke="#0067ff" stroke-width="4"/>
        <text x="249" y="345" fill="#fff" font-family="Arial, sans-serif" font-weight="700" font-size="16" transform="rotate(90 249 345)">FULL INSEAM</text>
      </svg>
    </figure>
    <p>Measure <strong>from the crotch seam all the way down the inner leg to the hem.</strong></p>
    <div class="csg-mini-note">Follow the inner seam — not the outside leg.</div>
  </article>
</div>

      <div class="csg-accuracy" aria-label="Tips for accuracy">
        <div class="csg-accuracy-title">Tips for Accuracy</div>
        <div class="csg-accuracy-item"><span class="csg-accuracy-num">1</span><span>Lay jeans flat and smooth out wrinkles.</span></div>
        <div class="csg-accuracy-item"><span class="csg-accuracy-num">2</span><span>Button and zip the jeans before measuring.</span></div>
        <div class="csg-accuracy-item"><span class="csg-accuracy-num">3</span><span>Compare with a pair that already fits you well.</span></div>
      </div>
    </section>
  </div>
</div>


<style>
#carbon-size-guide-slim {
  --csg-blue:#0067ff;
  --csg-blue-dark:#0055d5;
  --csg-blue-soft:#eaf3ff;
  --csg-ink:#111827;
  --csg-muted:#5f6b7a;
  --csg-line:#dbe3ed;
  --csg-soft:#f5f7fa;
  --csg-white:#fff;
  --csg-head-font:var(--font-heading-family, "Bebas Neue", "Arial Narrow", Arial, sans-serif);
  --csg-body-font:var(--font-body-family, "Montserrat", Arial, sans-serif);
  font-family:var(--csg-body-font);
  color:var(--csg-ink);
  width:100%;
  max-width:1180px;
  margin:0 auto;
  padding:4px 4px 24px;
}
#carbon-size-guide-slim *{box-sizing:border-box}
#carbon-size-guide-slim button{font:inherit}
#carbon-size-guide-slim .csg-shell{background:var(--csg-white);width:100%}
#carbon-size-guide-slim .csg-header{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:18px}
#carbon-size-guide-slim .csg-kicker{font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--csg-muted);font-size:13px;margin:0 0 6px}
#carbon-size-guide-slim .csg-title{font-family:var(--csg-head-font);font-size:clamp(34px,4.2vw,58px);line-height:.98;letter-spacing:.01em;text-transform:uppercase;margin:0;font-weight:800}
#carbon-size-guide-slim .csg-subtitle{font-size:18px;line-height:1.5;color:var(--csg-muted);margin:12px 0 0;max-width:780px}
#carbon-size-guide-slim .csg-blue-rule{width:76px;height:5px;border-radius:999px;background:var(--csg-blue);margin-top:13px}
#carbon-size-guide-slim .csg-topgrid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(300px,.8fr);gap:18px;align-items:start}
#carbon-size-guide-slim .csg-card{background:var(--csg-soft);border:1px solid var(--csg-line);border-radius:14px;padding:20px}
#carbon-size-guide-slim .csg-card-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:16px;flex-wrap:wrap}
#carbon-size-guide-slim .csg-h2{font-family:var(--csg-head-font);font-size:30px;line-height:1;text-transform:uppercase;margin:0;font-weight:800;letter-spacing:.01em}
#carbon-size-guide-slim .csg-unit-toggle{display:inline-flex;background:#e9edf3;border-radius:999px;padding:4px;gap:3px}
#carbon-size-guide-slim .csg-unit-toggle button{border:0;background:transparent;color:var(--csg-muted);font-weight:800;font-size:16px;min-width:66px;padding:9px 15px;border-radius:999px;cursor:pointer;transition:.18s ease}
#carbon-size-guide-slim .csg-unit-toggle button[aria-pressed="true"]{background:var(--csg-blue);color:#fff;box-shadow:0 4px 12px rgba(0,103,255,.22)}
#carbon-size-guide-slim .csg-table-wrap{border:1px solid var(--csg-line);border-radius:12px;overflow:hidden;background:#fff}
#carbon-size-guide-slim table{width:100%;border-collapse:collapse;table-layout:fixed;font-variant-numeric:tabular-nums}
#carbon-size-guide-slim thead th{background:#17202c;color:#fff;text-align:center;font-size:16px;font-weight:800;padding:15px 9px;border-right:1px solid #536071}
#carbon-size-guide-slim thead th:last-child{border-right:0}
#carbon-size-guide-slim tbody th,#carbon-size-guide-slim tbody td{text-align:center;font-size:17px;line-height:1.2;padding:13px 8px;border-right:1px solid #e2e8f0;border-top:1px solid #e7edf4;background:#fff;transition:.16s ease}
#carbon-size-guide-slim tbody th:last-child,#carbon-size-guide-slim tbody td:last-child{border-right:0}
#carbon-size-guide-slim tbody tr:nth-child(even) th,#carbon-size-guide-slim tbody tr:nth-child(even) td{background:#f7f9fc}
#carbon-size-guide-slim tbody tr{cursor:pointer}
#carbon-size-guide-slim tbody tr:hover th,#carbon-size-guide-slim tbody tr:hover td{background:#eef5ff}
#carbon-size-guide-slim tbody tr.csg-selected th,#carbon-size-guide-slim tbody tr.csg-selected td{background:#dcecff;color:var(--csg-blue-dark);font-weight:800}
#carbon-size-guide-slim tbody th{font-weight:800}
#carbon-size-guide-slim .csg-table-note{font-size:14px;line-height:1.45;color:var(--csg-muted);margin:12px 2px 0}
#carbon-size-guide-slim .csg-side{display:flex;flex-direction:column;gap:14px}
#carbon-size-guide-slim .csg-size-buttons{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin-top:14px}
#carbon-size-guide-slim .csg-size-btn{border:1.5px solid #cbd5e1;background:#fff;color:var(--csg-ink);border-radius:10px;min-height:48px;font-size:18px;font-weight:800;cursor:pointer;transition:.18s ease}
#carbon-size-guide-slim .csg-size-btn:hover{border-color:var(--csg-blue);color:var(--csg-blue-dark)}
#carbon-size-guide-slim .csg-size-btn[aria-pressed="true"]{background:var(--csg-blue);border-color:var(--csg-blue);color:#fff;box-shadow:0 5px 14px rgba(0,103,255,.18)}
#carbon-size-guide-slim .csg-help{display:flex;gap:13px;align-items:flex-start;background:var(--csg-blue-soft);border:1px solid #cde2ff;border-radius:12px;padding:16px 17px;font-size:16px;line-height:1.5;color:#29415f}
#carbon-size-guide-slim .csg-help-icon{width:30px;height:30px;border-radius:50%;background:var(--csg-blue);color:#fff;display:grid;place-items:center;font-weight:900;flex:0 0 30px;margin-top:1px}
#carbon-size-guide-slim .csg-help strong{color:var(--csg-blue-dark)}
#carbon-size-guide-slim .csg-selected-label{font-size:14px;color:var(--csg-muted);margin-top:10px;min-height:20px}
#carbon-size-guide-slim .csg-section{margin-top:24px}
#carbon-size-guide-slim .csg-section-head{display:flex;align-items:end;justify-content:space-between;gap:14px;margin-bottom:14px}
#carbon-size-guide-slim .csg-measure-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
#carbon-size-guide-slim .csg-measure-card{border:1px solid var(--csg-line);border-radius:14px;background:#fff;padding:16px;box-shadow:0 2px 12px rgba(15,23,42,.035)}
#carbon-size-guide-slim .csg-measure-title{display:flex;align-items:center;gap:10px;font-family:var(--csg-head-font);font-size:26px;text-transform:uppercase;font-weight:800;margin-bottom:10px}
#carbon-size-guide-slim .csg-step{width:34px;height:34px;display:grid;place-items:center;border-radius:50%;background:var(--csg-blue);color:#fff;font-family:var(--csg-body-font);font-size:17px;font-weight:900;flex:0 0 34px}
#carbon-size-guide-slim .csg-measure-figure{margin:0;background:#f6f8fb;border-radius:10px;overflow:hidden;display:flex;justify-content:center;align-items:center;min-height:210px}
