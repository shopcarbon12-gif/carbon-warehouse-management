<!-- CARBON interactive size guide: Slim Fit Jeans (metafield key: slim) -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&display=swap">
<div id="carbon-size-guide-slim" class="carbon-size-guide" data-fit="slim">
<style>
/* Every selector is prefixed with the component's own id at build time, so this
   file is written unprefixed and stays readable. Nothing here can reach the rest
   of the product page. */
#carbon-size-guide-slim {
  --csg-ink: #0f172a;
  --csg-navy: #16233a;
  --csg-blue: #1d4ed8;
  --csg-blue-soft: #eff6ff;
  --csg-line: #e5e7eb;
  --csg-zebra: #f8fafc;
  --csg-muted: #4b5563;
  --csg-display: "Oswald", "Archivo Narrow", "Arial Narrow", Helvetica, sans-serif;
  --csg-body: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;

  /* One grid for the whole component. Desktop places the pieces into two
     columns with the measurement section spanning the description and table
     rows, so HOW TO MEASURE starts level with the description exactly as in the
     comp. Phone collapses to one column and re-orders, rather than inheriting
     the desktop sequence. */
  display: grid;
  grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
  column-gap: clamp(22px, 3vw, 44px);
  align-items: start;
  font-family: var(--csg-body);
  color: var(--csg-ink);
  background: #fff;
  /* clamp() rather than a media-query ladder: this sits in a modal whose width
     is set by the theme, so the type has to scale to the box it lands in. */
  padding: clamp(4px, 0.6vw, 10px) clamp(18px, 2.2vw, 30px) clamp(18px, 2.2vw, 30px);
  -webkit-font-smoothing: antialiased;
  text-align: left;
}#carbon-size-guide-slim * { box-sizing: border-box; min-width: 0; }#carbon-size-guide-slim :focus-visible { outline: 2px solid var(--csg-blue); outline-offset: 2px; border-radius: 3px; }/* ── header ─────────────────────────────────────────────────────────── */
/* Spans both columns so a long fit name has the whole modal to sit on one
   line, with room reserved on the right for the unit switch that shares the
   row. */
#carbon-size-guide-slim .csg-top {
  grid-column: 1 / -1; grid-row: 1;
  padding-right: 210px;
  margin-bottom: clamp(16px, 1.8vw, 24px);
}#carbon-size-guide-slim .csg-units-cell { display: contents; }#carbon-size-guide-slim .csg-wordmark {
  /* The wordmark is the brand's own letterform — a normal-width grotesque with
     wide tracking. Setting it in the condensed headline face made it read as a
     label rather than as the logo. */
  font-family: var(--csg-body); font-weight: 700;
  font-size: 14px; letter-spacing: .32em; text-transform: uppercase;
  margin: 0 0 8px; color: var(--csg-ink);
}#carbon-size-guide-slim .csg-title { margin: 0; line-height: .9; }/* The fit name carries the weight; "Size Guide" sits under it lighter and
   smaller. That contrast is the whole title treatment. */
#carbon-size-guide-slim .csg-title-fit {
  display: block; font-family: var(--csg-display); font-weight: 700;
  font-size: clamp(26px, 4.2vw, 56px); letter-spacing: -.005em;
  text-transform: uppercase; white-space: nowrap;
}#carbon-size-guide-slim .csg-title-sub {
  display: block; font-family: var(--csg-display); font-weight: 300;
  font-size: clamp(21px, 3vw, 38px); letter-spacing: .005em;
  text-transform: uppercase; color: var(--csg-ink);
}#carbon-size-guide-slim .csg-rule { display: block; width: 148px; height: 4px; background: var(--csg-blue); margin: 14px 0 0; }#carbon-size-guide-slim .csg-subtitle {
  grid-column: 1; grid-row: 2;
  margin: 0 0 22px; font-size: clamp(14px, 1.05vw, 16px); line-height: 1.55;
  color: var(--csg-muted); max-width: 44ch;
}/* unit switch, top right of the header */
#carbon-size-guide-slim .csg-units {
  grid-column: 2; grid-row: 1; justify-self: end; align-self: start;
  display: inline-flex; padding: 5px; gap: 4px;
  background: #f1f3f7; border-radius: 999px; border: 1px solid var(--csg-line);
}#carbon-size-guide-slim .csg-unit {
  appearance: none; border: 0; cursor: pointer; background: transparent;
  font-family: var(--csg-display); font-weight: 600; font-size: 15px;
  letter-spacing: .12em; text-transform: uppercase; color: var(--csg-muted);
  padding: 9px 26px; border-radius: 999px;
  transition: background-color .18s ease, color .18s ease;
}#carbon-size-guide-slim .csg-unit[aria-pressed="true"] { background: var(--csg-blue); color: #fff; }/* ── mobile size picker (hidden on desktop, where rows are clicked) ──── */
#carbon-size-guide-slim .csg-picker { display: none; grid-column: 1; grid-row: 3; margin: 0 0 16px; }#carbon-size-guide-slim .csg-picker-label {
  display: block; font-size: 13px; color: var(--csg-muted); margin: 0 0 6px;
}#carbon-size-guide-slim .csg-select {
  width: 100%; appearance: none; background: #fff url("data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='14' height='9' viewBox='0 0 14 9'%3E%3Cpath d='M1 1l6 6 6-6' fill='none' stroke='%230f172a' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E") no-repeat right 14px center;
  border: 1px solid var(--csg-line); border-radius: 10px;
  padding: 13px 40px 13px 14px; font-family: var(--csg-display); font-weight: 600;
  font-size: 19px; color: var(--csg-ink);
}/* ── two-column body ────────────────────────────────────────────────── */
#carbon-size-guide-slim .csg-chart { grid-column: 1; grid-row: 4; }/* Spans the description and chart rows so its heading sits level with the
   description, not below the whole header. */
#carbon-size-guide-slim .csg-measure { grid-column: 2; grid-row: 2 / 5; }/* ── table ──────────────────────────────────────────────────────────── */
#carbon-size-guide-slim .csg-table {
  width: 100%; border-collapse: separate; border-spacing: 0;
  border: 1px solid var(--csg-line); border-radius: 10px; overflow: hidden;
  font-variant-numeric: tabular-nums;
}#carbon-size-guide-slim .csg-table thead th {
  background: var(--csg-navy); color: #fff; text-align: center;
  font-family: var(--csg-display); font-weight: 600; font-size: 14px;
  letter-spacing: .07em; text-transform: uppercase; padding: 13px 8px;
  line-height: 1.2;
}/* Two lines, as in the comp: the measurement, then its unit underneath. */
#carbon-size-guide-slim .csg-th-unit { display: block; font-weight: 400; font-size: 12.5px; opacity: .85; }#carbon-size-guide-slim .csg-table tbody th, #carbon-size-guide-slim .csg-table tbody td {
  text-align: center; padding: 13px 8px; font-size: 16px;
  border-top: 1px solid var(--csg-line); color: var(--csg-ink);
}#carbon-size-guide-slim .csg-table tbody th { font-weight: 700; }#carbon-size-guide-slim .csg-table tbody td { color: var(--csg-muted); }#carbon-size-guide-slim .csg-table tbody tr:nth-child(even) th, #carbon-size-guide-slim .csg-table tbody tr:nth-child(even) td { background: var(--csg-zebra); }#carbon-size-guide-slim .csg-table tbody tr { cursor: pointer; }#carbon-size-guide-slim .csg-table tbody tr:hover th, #carbon-size-guide-slim .csg-table tbody tr:hover td { background: var(--csg-blue-soft); }/* Solid blue with white text — a tint was not readable enough as "chosen". */
#carbon-size-guide-slim .csg-table tbody tr[aria-selected="true"] th, #carbon-size-guide-slim .csg-table tbody tr[aria-selected="true"] td {
  background: var(--csg-blue); color: #fff; font-weight: 700;
}#carbon-size-guide-slim .csg-table-foot { margin: 10px 2px 0; font-size: 12.5px; color: #6b7280; }/* ── how to measure ─────────────────────────────────────────────────── */
#carbon-size-guide-slim .csg-measure { border: 0; min-width: 0; }#carbon-size-guide-slim .csg-measure > summary {
  list-style: none; cursor: default; display: flex; align-items: center;
  justify-content: space-between; gap: 12px; margin: 0 0 16px;
}#carbon-size-guide-slim .csg-measure > summary::-webkit-details-marker { display: none; }#carbon-size-guide-slim .csg-h3 {
  margin: 0; font-family: var(--csg-display); font-weight: 600;
  font-size: clamp(20px, 1.9vw, 27px); letter-spacing: .02em; text-transform: uppercase;
}#carbon-size-guide-slim .csg-chev { display: none; flex: 0 0 auto; }#carbon-size-guide-slim .csg-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }#carbon-size-guide-slim .csg-card {
  border: 1px solid var(--csg-line); border-radius: 12px; background: #fff;
  padding: 11px; display: flex; flex-direction: column; gap: 11px;
}#carbon-size-guide-slim .csg-card-head { display: flex; align-items: center; gap: 9px; margin: 0; }#carbon-size-guide-slim .csg-badge {
  flex: 0 0 auto; width: 26px; height: 26px; border-radius: 50%;
  background: var(--csg-blue); color: #fff; display: inline-grid; place-items: center;
  font-family: var(--csg-display); font-weight: 600; font-size: 14px;
}#carbon-size-guide-slim .csg-card-name {
  font-family: var(--csg-display); font-weight: 600; font-size: 17px;
  letter-spacing: .05em; text-transform: uppercase;
}#carbon-size-guide-slim .csg-figure { margin: 0; border-radius: 9px; overflow: hidden; background: #f5f5f5; }/* One box for all three so the cards are identical, and contain rather than
   cover so none is cropped — the sources do not share a shape (waist and hip
   are 4:3, the inseam 2:3) and cropping either one cuts off the tape, which is
   the only thing these photos exist to show.

   The box colour is sampled from the photographs' own backdrop (#f6f6f6), so
   the area a contained photo does not fill reads as more backdrop rather than
   as a grey band around a floating image. */
#carbon-size-guide-slim .csg-photo {
  display: block; width: 100%; height: auto;
  aspect-ratio: 1 / 1; object-fit: contain; background: #f5f5f5;
}#carbon-size-guide-slim .csg-card-text { margin: 0; font-size: 14.5px; line-height: 1.5; color: var(--csg-muted); }/* ── helpful note ───────────────────────────────────────────────────── */
#carbon-size-guide-slim .csg-note {
  display: flex; gap: 12px; align-items: flex-start; margin: 20px 0 0;
  background: var(--csg-blue-soft); border-radius: 10px; padding: 17px 19px;
  font-size: 14.5px; line-height: 1.6; color: #26324a;
}#carbon-size-guide-slim .csg-note-icon {
  flex: 0 0 auto; width: 22px; height: 22px; border-radius: 50%;
  background: var(--csg-blue); color: #fff; display: inline-grid; place-items: center;
  font-size: 13px; font-weight: 700; font-style: italic; font-family: var(--csg-body);
}#carbon-size-guide-slim .csg-note b, #carbon-size-guide-slim .csg-note strong { color: var(--csg-blue); }/* ── tips strip ─────────────────────────────────────────────────────── */
#carbon-size-guide-slim .csg-tips {
  grid-column: 1 / -1;
  /* nowrap so the tagline stays pinned right against its divider; the list of
     tips wraps inside its own track instead of pushing the tagline onto a line
     of its own. */
  display: flex; align-items: center; gap: clamp(14px, 1.8vw, 26px); flex-wrap: nowrap;
  margin: clamp(22px, 2.6vw, 32px) 0 0; padding: 18px clamp(16px, 1.8vw, 24px);
  border: 1px solid var(--csg-line); border-radius: 12px;
}#carbon-size-guide-slim .csg-tips-icon { flex: 0 0 auto; color: var(--csg-ink); display: grid; place-items: center; }#carbon-size-guide-slim .csg-tips-title {
  margin: 0; flex: 0 0 auto; font-family: var(--csg-display); font-weight: 600;
  font-size: 17px; letter-spacing: .05em; text-transform: uppercase;
}#carbon-size-guide-slim .csg-tips-list {
  /* Three equal columns rather than a flex row: the three tips do not fit on one
     line beside the title and the tagline at this width, and a flex row put two
     on the first line and one alone on a second. A column each keeps the rhythm
     of the comp, and only the longest tip runs to a second line. */
  margin: 0; padding: 0; list-style: none;
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px clamp(12px, 1.3vw, 20px); flex: 1 1 auto;
}#carbon-size-guide-slim .csg-tips-list li { display: flex; align-items: flex-start; gap: 7px; font-size: 13.5px; line-height: 1.4; color: var(--csg-muted); }#carbon-size-guide-slim .csg-tick { flex: 0 0 auto; color: var(--csg-blue); margin-top: 1px; }#carbon-size-guide-slim .csg-tagline {
  margin: 0; flex: 0 0 auto; padding-left: clamp(14px, 1.8vw, 26px);
  border-left: 1px solid var(--csg-line); font-size: 11.5px; line-height: 1.7;
  letter-spacing: .16em; text-transform: uppercase; color: #9aa3b2; text-align: right;
}

/* ── tablet ─────────────────────────────────────────────────────────── */
@media (max-width: 1000px) {#carbon-size-guide-slim { grid-template-columns: 1fr; }#carbon-size-guide-slim .csg-top, #carbon-size-guide-slim .csg-units, #carbon-size-guide-slim .csg-subtitle, #carbon-size-guide-slim .csg-picker, #carbon-size-guide-slim .csg-chart, #carbon-size-guide-slim .csg-measure, #carbon-size-guide-slim .csg-tips {
    grid-column: 1; grid-row: auto;
  }/* The comp reads name, then description, then the unit switch. */
#carbon-size-guide-slim .csg-top { order: 1; padding-right: 0; }#carbon-size-guide-slim .csg-subtitle { order: 2; }#carbon-size-guide-slim .csg-units { order: 3; justify-self: stretch; }#carbon-size-guide-slim .csg-picker { order: 4; }#carbon-size-guide-slim .csg-chart { order: 5; }#carbon-size-guide-slim .csg-measure { order: 6; }#carbon-size-guide-slim .csg-tips { order: 7; }#carbon-size-guide-slim .csg-measure { margin-top: 20px; }#carbon-size-guide-slim .csg-tips { flex-wrap: wrap; }#carbon-size-guide-slim .csg-tagline { display: none; }
}

/* ── phone: a different layout, not a smaller one ───────────────────── */
@media (max-width: 680px) {#carbon-size-guide-slim { padding: 16px; }#carbon-size-guide-slim .csg-units { width: 100%; justify-content: stretch; }#carbon-size-guide-slim .csg-unit { flex: 1 1 0; padding: 11px 0; }#carbon-size-guide-slim .csg-subtitle { font-size: 13.5px; }#carbon-size-guide-slim .csg-picker { display: block; }#carbon-size-guide-slim .csg-table thead th { font-size: 11.5px; padding: 9px 4px; letter-spacing: .04em; }#carbon-size-guide-slim .csg-th-unit { font-size: 10.5px; }#carbon-size-guide-slim .csg-table tbody th, #carbon-size-guide-slim .csg-table tbody td { font-size: 14px; padding: 10px 4px; }/* The measure section becomes a real accordion, and each card becomes a row
     with a thumbnail — three tall photo cards in a column is a lot of scrolling
     for something read once. */
#carbon-size-guide-slim .csg-measure { border: 1px solid var(--csg-line); border-radius: 12px; padding: 14px; margin-top: 18px; }#carbon-size-guide-slim .csg-measure > summary { cursor: pointer; margin-bottom: 0; }#carbon-size-guide-slim .csg-measure[open] > summary { margin-bottom: 14px; }#carbon-size-guide-slim .csg-chev { display: block; transition: transform .2s ease; }#carbon-size-guide-slim .csg-measure[open] .csg-chev { transform: rotate(180deg); }#carbon-size-guide-slim .csg-cards { grid-template-columns: 1fr; gap: 12px; }#carbon-size-guide-slim .csg-card {
    display: grid; grid-template-columns: 62px minmax(0, 1fr);
    grid-template-rows: auto auto; column-gap: 12px; row-gap: 4px;
    border: 0; border-top: 1px solid var(--csg-line); border-radius: 0; padding: 12px 0 0;
  }#carbon-size-guide-slim .csg-card:first-child { border-top: 0; padding-top: 0; }#carbon-size-guide-slim .csg-figure { grid-row: 1 / span 2; }/* At thumbnail size a letterboxed photo is mostly empty grey, so the two
     flat-lays fill their square. The inseam keeps contain — cropping the one
     photo whose whole job is crotch-to-hem would defeat it. */
#carbon-size-guide-slim .csg-photo { aspect-ratio: 1 / 1; object-fit: cover; }#carbon-size-guide-slim .csg-photo-inseam { object-fit: contain; }#carbon-size-guide-slim .csg-card-head { grid-column: 2; }#carbon-size-guide-slim .csg-card-text { grid-column: 2; font-size: 13.5px; }#carbon-size-guide-slim .csg-tips { flex-direction: column; align-items: flex-start; gap: 10px; }#carbon-size-guide-slim .csg-tips-list { grid-template-columns: 1fr; gap: 9px; }#carbon-size-guide-slim .csg-note { font-size: 13.5px; }
}

</style>

