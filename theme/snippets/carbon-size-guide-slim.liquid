/* ── Carbon integration fix ──────────────────────────────────────────────────
   V2 declares .csg-inseam-card's grid-column four times across conflicting
   breakpoints, and inside this theme's popup the winning one put the inseam in
   a 340px column while its own inner layout asks for minmax(280px) + minmax(240px)
   + gap — about 542px. The copy overflowed the card and was clipped mid-sentence
   ("Start exa...", "the insid...").

   Waist and hip share a two-up row so their photos are big enough to read, and
   the inseam takes a full-width row of its own: it is the measurement people get
   wrong, and it is the one that needs to show crotch-to-hem in one piece.
   Declared last so it wins on source order rather than by inflating specificity. */
#carbon-size-guide-slim .csg-measure-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
#carbon-size-guide-slim .csg-inseam-card { grid-column: 1 / -1; }
#carbon-size-guide-slim .csg-inseam-layout { grid-template-columns: minmax(260px, 0.85fr) minmax(300px, 1.15fr); }
#carbon-size-guide-slim .csg-inseam-copy { min-width: 0; }
#carbon-size-guide-slim .csg-measure-card, #carbon-size-guide-slim .csg-measure-card * { min-width: 0; }

@media (max-width: 680px) {
  /* One card per row on a phone, each the full width of the popup, so no photo
     is ever reduced to a thumbnail. */
  #carbon-size-guide-slim .csg-measure-grid { grid-template-columns: 1fr; }
  #carbon-size-guide-slim .csg-inseam-layout { grid-template-columns: 1fr; }
}

#carbon-size-guide-slim .csg-title { text-wrap: balance; }
#carbon-size-guide-slim .csg-title .csg-title-line { display: block; }
</style>


<script>
(function(){
  var root = document.getElementById('carbon-size-guide-slim');
  if(!root || root.dataset.csgReady === '1') return;
  root.dataset.csgReady = '1';

  var unit = 'in';
  var selectedSize = null;
  var unitButtons = Array.prototype.slice.call(root.querySelectorAll('[data-csg-unit]'));
  var rows = Array.prototype.slice.call(root.querySelectorAll('[data-csg-row]'));
  var sizeButtons = Array.prototype.slice.call(root.querySelectorAll('[data-csg-size]'));
  var selectedLabel = root.querySelector('[data-csg-selected-label]');
  var headers = Array.prototype.slice.call(root.querySelectorAll('[data-csg-measure-head]'));

  function updateUnits(nextUnit){
    unit = nextUnit;
    unitButtons.forEach(function(btn){btn.setAttribute('aria-pressed', btn.dataset.csgUnit === unit ? 'true':'false');});
    headers.forEach(function(h){h.textContent = h.dataset.csgLabel + ' (' + unit + ')';});
    rows.forEach(function(row){
      ['waist','hip','inseam'].forEach(function(metric){
        var cell = row.querySelector('[data-csg-cell="'+metric+'"]');
        if(cell) cell.textContent = row.dataset[unit + metric.charAt(0).toUpperCase() + metric.slice(1)];
      });
    });
    var note = root.querySelector('[data-csg-table-note]');
    if(note){
      note.textContent = unit === 'in'
        ? 'Garment measurements shown in inches. Waist and hip are measured flat and doubled.'
        : 'Garment measurements shown in centimetres. Waist and hip are measured flat and doubled.';
    }
  }

  function selectSize(size, scrollToRow){
    selectedSize = size;
    rows.forEach(function(row){
      var on = row.dataset.csgRow === size;
      row.classList.toggle('csg-selected', on);
      row.setAttribute('aria-selected', on ? 'true':'false');
      if(on && scrollToRow && window.innerWidth < 561){
        row.scrollIntoView({block:'nearest', behavior:'smooth'});
      }
    });
    sizeButtons.forEach(function(btn){btn.setAttribute('aria-pressed', btn.dataset.csgSize === size ? 'true':'false');});
    if(selectedLabel) selectedLabel.textContent = 'Selected size: ' + size + '. Click again or choose another size to compare.';
  }

  unitButtons.forEach(function(btn){btn.addEventListener('click',function(){updateUnits(btn.dataset.csgUnit);});});
  rows.forEach(function(row){
    row.tabIndex = 0;
    row.addEventListener('click',function(){selectSize(row.dataset.csgRow,false);});
    row.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();selectSize(row.dataset.csgRow,false);}});
  });
  sizeButtons.forEach(function(btn){btn.addEventListener('click',function(){selectSize(btn.dataset.csgSize,true);});});

  updateUnits('in');
})();
</script>

