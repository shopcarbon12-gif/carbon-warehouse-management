}/* Two lines, as in the comp: the measurement, then its unit underneath. */
#carbon-size-guide-baggy .csg-th-unit { display: block; font-weight: 400; font-size: 12.5px; opacity: .85; }#carbon-size-guide-baggy .csg-table tbody th, #carbon-size-guide-baggy .csg-table tbody td {
