}#carbon-size-guide-baggy .csg-measure > summary::-webkit-details-marker { display: none; }#carbon-size-guide-baggy .csg-h3 {
  margin: 0; font-family: var(--csg-display); font-weight: 600;
  font-size: clamp(20px, 1.9vw, 27px); letter-spacing: .02em; text-transform: uppercase;
}#carbon-size-guide-baggy .csg-chev { display: none; flex: 0 0 auto; }#carbon-size-guide-baggy .csg-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }#carbon-size-guide-baggy .csg-card {
  border: 1px solid var(--csg-line); border-radius: 12px; background: #fff;
  padding: 11px; display: flex; flex-direction: column; gap: 11px;
}#carbon-size-guide-baggy .csg-card-head { display: flex; align-items: center; gap: 9px; margin: 0; }#carbon-size-guide-baggy .csg-badge {
  flex: 0 0 auto; width: 26px; height: 26px; border-radius: 50%;
  background: var(--csg-blue); color: #fff; display: inline-grid; place-items: center;
