}#carbon-size-guide-baggy .csg-rule { display: block; width: 148px; height: 4px; background: var(--csg-blue); margin: 14px 0 0; }#carbon-size-guide-baggy .csg-subtitle {
  grid-column: 1; grid-row: 2;
  margin: 0 0 22px; font-size: clamp(14px, 1.05vw, 16px); line-height: 1.55;
  color: var(--csg-muted); max-width: 44ch;
}/* unit switch, top right of the header */
#carbon-size-guide-baggy .csg-units {
  grid-column: 2; grid-row: 1; justify-self: end; align-self: start;
  display: inline-flex; padding: 5px; gap: 4px;
