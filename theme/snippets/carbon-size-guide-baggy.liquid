#carbon-size-guide-baggy {
  --csg-ink: #0f172a;
  --csg-navy: #16233a;
  --csg-blue: #1d4ed8;
  --csg-blue-soft: #eff6ff;
  --csg-line: #e5e7eb;
  --csg-zebra: #f8fafc;
  --csg-muted: #4b5563;
