  }/* The comp reads name, then description, then the unit switch. */
#carbon-size-guide-baggy .csg-top { order: 1; padding-right: 0; }#carbon-size-guide-baggy .csg-subtitle { order: 2; }#carbon-size-guide-baggy .csg-units { order: 3; justify-self: stretch; }#carbon-size-guide-baggy .csg-picker { order: 4; }#carbon-size-guide-baggy .csg-chart { order: 5; }#carbon-size-guide-baggy .csg-measure { order: 6; }#carbon-size-guide-baggy .csg-tips { order: 7; }#carbon-size-guide-baggy .csg-measure { margin-top: 20px; }#carbon-size-guide-baggy .csg-tips { flex-wrap: wrap; }#carbon-size-guide-baggy .csg-tagline { display: none; }
