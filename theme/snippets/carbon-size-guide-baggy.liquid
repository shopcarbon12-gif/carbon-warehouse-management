  }#carbon-size-guide-baggy .csg-card:first-child { border-top: 0; padding-top: 0; }#carbon-size-guide-baggy .csg-figure { grid-row: 1 / span 2; }/* At thumbnail size a letterboxed photo is mostly empty grey, so the two
