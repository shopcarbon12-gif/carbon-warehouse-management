#carbon-size-guide-baggy .csg-measure { border: 1px solid var(--csg-line); border-radius: 12px; padding: 14px; margin-top: 18px; }#carbon-size-guide-baggy .csg-measure > summary { cursor: pointer; margin-bottom: 0; }#carbon-size-guide-baggy .csg-measure[open] > summary { margin-bottom: 14px; }#carbon-size-guide-baggy .csg-chev { display: block; transition: transform .2s ease; }#carbon-size-guide-baggy .csg-measure[open] .csg-chev { transform: rotate(180deg); }#carbon-size-guide-baggy .csg-cards { grid-template-columns: 1fr; gap: 12px; }#carbon-size-guide-baggy .csg-card {
