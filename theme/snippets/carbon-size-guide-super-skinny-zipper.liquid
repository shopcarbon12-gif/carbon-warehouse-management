}#carbon-size-guide-super-skinny-zipper .csg-table tbody th { font-weight: 700; }#carbon-size-guide-super-skinny-zipper .csg-table tbody td { color: var(--csg-muted); }#carbon-size-guide-super-skinny-zipper .csg-table tbody tr:nth-child(even) th, #carbon-size-guide-super-skinny-zipper .csg-table tbody tr:nth-child(even) td { background: var(--csg-zebra); }#carbon-size-guide-super-skinny-zipper .csg-table tbody tr { cursor: pointer; }#carbon-size-guide-super-skinny-zipper .csg-table tbody tr:hover th, #carbon-size-guide-super-skinny-zipper .csg-table tbody tr:hover td { background: var(--csg-blue-soft); }/* Solid blue with white text — a tint was not readable enough as "chosen". */
#carbon-size-guide-super-skinny-zipper .csg-table tbody tr[aria-selected="true"] th, #carbon-size-guide-super-skinny-zipper .csg-table tbody tr[aria-selected="true"] td {
  background: var(--csg-blue); color: #fff; font-weight: 700;
}#carbon-size-guide-super-skinny-zipper .csg-table-foot { margin: 10px 2px 0; font-size: 12.5px; color: #6b7280; }/* ── how to measure ─────────────────────────────────────────────────── */
#carbon-size-guide-super-skinny-zipper .csg-measure { border: 0; }#carbon-size-guide-super-skinny-zipper .csg-measure > summary {
  list-style: none; cursor: default; display: flex; align-items: center;
  justify-content: space-between; gap: 12px; margin: 0 0 14px;
}#carbon-size-guide-super-skinny-zipper .csg-measure > summary::-webkit-details-marker { display: none; }#carbon-size-guide-super-skinny-zipper .csg-h3 {
  margin: 0; font-family: var(--csg-display); font-weight: 600;
  font-size: clamp(20px, 1.9vw, 27px); letter-spacing: .02em; text-transform: uppercase;
}#carbon-size-guide-super-skinny-zipper .csg-chev { display: none; flex: 0 0 auto; }#carbon-size-guide-super-skinny-zipper .csg-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }#carbon-size-guide-super-skinny-zipper .csg-card {
  border: 1px solid var(--csg-line); border-radius: 12px; background: #fff;
  padding: 12px; display: flex; flex-direction: column; gap: 10px;
}#carbon-size-guide-super-skinny-zipper .csg-card-head { display: flex; align-items: center; gap: 9px; margin: 0; }#carbon-size-guide-super-skinny-zipper .csg-badge {
  flex: 0 0 auto; width: 26px; height: 26px; border-radius: 50%;
  background: var(--csg-blue); color: #fff; display: inline-grid; place-items: center;
  font-family: var(--csg-display); font-weight: 600; font-size: 14px;
}#carbon-size-guide-super-skinny-zipper .csg-card-name {
  font-family: var(--csg-display); font-weight: 600; font-size: 17px;
  letter-spacing: .05em; text-transform: uppercase;
}#carbon-size-guide-super-skinny-zipper .csg-figure { margin: 0; border-radius: 9px; overflow: hidden; background: #f4f6f9; }/* One box for all three so the cards line up, and contain rather than cover so
   none of them is cropped. The sources do not share a shape — waist and hip are
   4:3, the inseam is 2:3 — and cropping either to match the other cuts off the
   tape, which is the only thing these photos are here to show. */
#carbon-size-guide-super-skinny-zipper .csg-photo {
  display: block; width: 100%; height: auto;
  aspect-ratio: 4 / 5; object-fit: contain; background: #f4f6f9;
}#carbon-size-guide-super-skinny-zipper .csg-card-text { margin: 0; font-size: 14.5px; line-height: 1.5; color: var(--csg-muted); }/* ── helpful note ───────────────────────────────────────────────────── */
#carbon-size-guide-super-skinny-zipper .csg-note {
  display: flex; gap: 11px; align-items: flex-start; margin: 16px 0 0;
  background: var(--csg-blue-soft); border-radius: 10px; padding: 14px 16px;
  font-size: 14.5px; line-height: 1.55; color: #26324a;
}#carbon-size-guide-super-skinny-zipper .csg-note-icon {
  flex: 0 0 auto; width: 22px; height: 22px; border-radius: 50%;
  background: var(--csg-blue); color: #fff; display: inline-grid; place-items: center;
  font-size: 13px; font-weight: 700; font-style: italic; font-family: var(--csg-body);
}#carbon-size-guide-super-skinny-zipper .csg-note b, #carbon-size-guide-super-skinny-zipper .csg-note strong { color: var(--csg-blue); }/* ── tips strip ─────────────────────────────────────────────────────── */
#carbon-size-guide-super-skinny-zipper .csg-tips {
  /* nowrap so the tagline stays pinned right against its divider; the list of
     tips wraps inside its own track instead of pushing the tagline onto a line
     of its own. */
  display: flex; align-items: center; gap: clamp(14px, 1.8vw, 26px); flex-wrap: nowrap;
  margin: clamp(18px, 2vw, 26px) 0 0; padding: 16px clamp(14px, 1.6vw, 22px);
  border: 1px solid var(--csg-line); border-radius: 12px;
}#carbon-size-guide-super-skinny-zipper .csg-tips-icon { flex: 0 0 auto; color: var(--csg-ink); display: grid; place-items: center; }#carbon-size-guide-super-skinny-zipper .csg-tips-title {
  margin: 0; flex: 0 0 auto; font-family: var(--csg-display); font-weight: 600;
  font-size: 17px; letter-spacing: .05em; text-transform: uppercase;
}#carbon-size-guide-super-skinny-zipper .csg-tips-list {
  margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap;
  gap: 8px clamp(14px, 1.8vw, 28px); flex: 1 1 auto;
}#carbon-size-guide-super-skinny-zipper .csg-tips-list li { display: flex; align-items: center; gap: 8px; font-size: 14.5px; color: var(--csg-muted); }#carbon-size-guide-super-skinny-zipper .csg-tick { flex: 0 0 auto; color: var(--csg-blue); }#carbon-size-guide-super-skinny-zipper .csg-tagline {
  margin: 0; flex: 0 0 auto; padding-left: clamp(14px, 1.8vw, 26px);
  border-left: 1px solid var(--csg-line); font-size: 11.5px; line-height: 1.7;
  letter-spacing: .16em; text-transform: uppercase; color: #9aa3b2; text-align: right;
}

/* ── tablet ─────────────────────────────────────────────────────────── */
@media (max-width: 1000px) {#carbon-size-guide-super-skinny-zipper .csg-body { grid-template-columns: 1fr; }#carbon-size-guide-super-skinny-zipper .csg-tips { flex-wrap: wrap; }#carbon-size-guide-super-skinny-zipper .csg-tagline { display: none; }
}

/* ── phone: a different layout, not a smaller one ───────────────────── */
@media (max-width: 680px) {#carbon-size-guide-super-skinny-zipper { padding: 16px; }#carbon-size-guide-super-skinny-zipper .csg-head { gap: 14px; }#carbon-size-guide-super-skinny-zipper .csg-units { width: 100%; justify-content: stretch; }#carbon-size-guide-super-skinny-zipper .csg-unit { flex: 1 1 0; padding: 11px 0; }#carbon-size-guide-super-skinny-zipper .csg-subtitle { font-size: 13.5px; }#carbon-size-guide-super-skinny-zipper .csg-picker { display: block; }#carbon-size-guide-super-skinny-zipper .csg-table thead th { font-size: 11.5px; padding: 9px 4px; letter-spacing: .04em; }#carbon-size-guide-super-skinny-zipper .csg-th-unit { font-size: 10.5px; }#carbon-size-guide-super-skinny-zipper .csg-table tbody th, #carbon-size-guide-super-skinny-zipper .csg-table tbody td { font-size: 14px; padding: 10px 4px; }/* The measure section becomes a real accordion, and each card becomes a row
     with a thumbnail — three tall photo cards in a column is a lot of scrolling
     for something read once. */
#carbon-size-guide-super-skinny-zipper .csg-measure { border: 1px solid var(--csg-line); border-radius: 12px; padding: 14px; margin-top: 18px; }#carbon-size-guide-super-skinny-zipper .csg-measure > summary { cursor: pointer; margin-bottom: 0; }#carbon-size-guide-super-skinny-zipper .csg-measure[open] > summary { margin-bottom: 14px; }#carbon-size-guide-super-skinny-zipper .csg-chev { display: block; transition: transform .2s ease; }#carbon-size-guide-super-skinny-zipper .csg-measure[open] .csg-chev { transform: rotate(180deg); }#carbon-size-guide-super-skinny-zipper .csg-cards { grid-template-columns: 1fr; gap: 12px; }#carbon-size-guide-super-skinny-zipper .csg-card {
    display: grid; grid-template-columns: 62px minmax(0, 1fr);
    grid-template-rows: auto auto; column-gap: 12px; row-gap: 4px;
    border: 0; border-top: 1px solid var(--csg-line); border-radius: 0; padding: 12px 0 0;
  }#carbon-size-guide-super-skinny-zipper .csg-card:first-child { border-top: 0; padding-top: 0; }#carbon-size-guide-super-skinny-zipper .csg-figure { grid-row: 1 / span 2; }/* At thumbnail size a letterboxed photo is mostly empty grey, so the two
     flat-lays fill their square. The inseam keeps contain — cropping the one
     photo whose whole job is crotch-to-hem would defeat it. */
#carbon-size-guide-super-skinny-zipper .csg-photo { aspect-ratio: 1 / 1; object-fit: cover; }#carbon-size-guide-super-skinny-zipper .csg-photo-inseam { object-fit: contain; }#carbon-size-guide-super-skinny-zipper .csg-card-head { grid-column: 2; }#carbon-size-guide-super-skinny-zipper .csg-card-text { grid-column: 2; font-size: 13.5px; }#carbon-size-guide-super-skinny-zipper .csg-tips { flex-direction: column; align-items: flex-start; gap: 10px; }#carbon-size-guide-super-skinny-zipper .csg-tips-list { flex-direction: column; gap: 8px; }#carbon-size-guide-super-skinny-zipper .csg-note { font-size: 13.5px; }
}

</style>

