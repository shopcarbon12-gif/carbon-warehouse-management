}#carbon-size-guide-super-skinny-zipper .csg-rule { display: block; width: 74px; height: 5px; background: var(--csg-blue); margin: 14px 0 0; }#carbon-size-guide-super-skinny-zipper .csg-subtitle {
  margin: 14px 0 0; font-size: clamp(14px, 1.05vw, 16px); line-height: 1.5;
