  padding: 9px 26px; border-radius: 999px;
  transition: background-color .18s ease, color .18s ease;
}#carbon-size-guide-super-skinny-zipper .csg-unit[aria-pressed="true"] { background: var(--csg-blue); color: #fff; }/* ── mobile size picker (hidden on desktop, where rows are clicked) ──── */
#carbon-size-guide-super-skinny-zipper .csg-picker { display: none; margin: 0 0 16px; }#carbon-size-guide-super-skinny-zipper .csg-picker-label {
  display: block; font-size: 13px; color: var(--csg-muted); margin: 0 0 6px;
}#carbon-size-guide-super-skinny-zipper .csg-select {
  width: 100%; appearance: none; background: #fff url("data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='14' height='9' viewBox='0 0 14 9'%3E%3Cpath d='M1 1l6 6 6-6' fill='none' stroke='%230f172a' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E") no-repeat right 14px center;
  border: 1px solid var(--csg-line); border-radius: 10px;
  padding: 13px 40px 13px 14px; font-family: var(--csg-display); font-weight: 600;
  font-size: 19px; color: var(--csg-ink);
}/* ── two-column body ────────────────────────────────────────────────── */
#carbon-size-guide-super-skinny-zipper .csg-body {
  display: grid; grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
  gap: clamp(20px, 2.4vw, 34px); align-items: start;
}/* ── table ──────────────────────────────────────────────────────────── */
#carbon-size-guide-super-skinny-zipper .csg-table {
  width: 100%; border-collapse: separate; border-spacing: 0;
  border: 1px solid var(--csg-line); border-radius: 10px; overflow: hidden;
  font-variant-numeric: tabular-nums;
}#carbon-size-guide-super-skinny-zipper .csg-table thead th {
  background: var(--csg-navy); color: #fff; text-align: center;
  font-family: var(--csg-display); font-weight: 600; font-size: 14px;
