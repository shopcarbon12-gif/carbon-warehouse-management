@media (max-width: 680px) {
  /* One column, so the hand-placed desktop rows above have to be released. */
  #carbon-size-guide-mens-swim-shorts .csg-chart, #carbon-size-guide-mens-swim-shorts .csg-more { display: none; }
  #carbon-size-guide-mens-swim-shorts .csg-subtitle { grid-row: auto; }
  #carbon-size-guide-mens-swim-shorts .csg-mob { display: block; order: 5; grid-column: 1; grid-row: auto; }
  #carbon-size-guide-mens-swim-shorts .csg-note-wrap { order: 6; grid-column: 1; grid-row: auto; }
  #carbon-size-guide-mens-swim-shorts .csg-tips { order: 7; }
}
@media (max-width: 380px) {
  /* Two columns of label + value stop fitting; one keeps every figure whole. */
  #carbon-size-guide-mens-swim-shorts .csg-kv { grid-template-columns: 1fr; }
}

</style>

