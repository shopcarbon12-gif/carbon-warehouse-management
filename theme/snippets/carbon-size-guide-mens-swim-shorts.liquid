}#carbon-size-guide-mens-swim-shorts .csg-card-text { margin: 0; font-size: 14.5px; line-height: 1.5; color: var(--csg-muted); }/* ── helpful note ───────────────────────────────────────────────────── */
#carbon-size-guide-mens-swim-shorts .csg-note {
  display: flex; gap: 12px; align-items: flex-start; margin: 20px 0 0;
  background: var(--csg-blue-soft); border-radius: 10px; padding: 17px 19px;
