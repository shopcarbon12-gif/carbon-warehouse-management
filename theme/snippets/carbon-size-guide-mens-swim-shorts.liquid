}#carbon-size-guide-mens-swim-shorts .csg-table-foot { margin: 10px 2px 0; font-size: 12.5px; color: #6b7280; }/* ── how to measure ─────────────────────────────────────────────────── */
#carbon-size-guide-mens-swim-shorts .csg-measure { border: 0; min-width: 0; }#carbon-size-guide-mens-swim-shorts .csg-measure > summary {
  list-style: none; cursor: default; display: flex; align-items: center;
  justify-content: space-between; gap: 12px; margin: 0 0 16px;
}#carbon-size-guide-mens-swim-shorts .csg-measure > summary::-webkit-details-marker { display: none; }#carbon-size-guide-mens-swim-shorts .csg-h3 {
  margin: 0; font-family: var(--csg-display); font-weight: 600;
  font-size: clamp(20px, 1.9vw, 27px); letter-spacing: .02em; text-transform: uppercase;
}#carbon-size-guide-mens-swim-shorts .csg-chev { display: none; flex: 0 0 auto; }#carbon-size-guide-mens-swim-shorts .csg-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }#carbon-size-guide-mens-swim-shorts .csg-card {
  border: 1px solid var(--csg-line); border-radius: 12px; background: #fff;
  padding: 11px; display: flex; flex-direction: column; gap: 11px;
}#carbon-size-guide-mens-swim-shorts .csg-card-head { display: flex; align-items: center; gap: 9px; margin: 0; }#carbon-size-guide-mens-swim-shorts .csg-badge {
  flex: 0 0 auto; width: 26px; height: 26px; border-radius: 50%;
  background: var(--csg-blue); color: #fff; display: inline-grid; place-items: center;
  font-family: var(--csg-display); font-weight: 600; font-size: 14px;
}#carbon-size-guide-mens-swim-shorts .csg-card-name {
  font-family: var(--csg-display); font-weight: 600; font-size: 17px;
  letter-spacing: .05em; text-transform: uppercase;
}#carbon-size-guide-mens-swim-shorts .csg-figure { margin: 0; border-radius: 9px; overflow: hidden; background: #f5f5f5; }/* One box for all three so the cards are identical, and contain rather than
