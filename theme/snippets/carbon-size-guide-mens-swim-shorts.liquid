#carbon-size-guide-mens-swim-shorts .csg-more { border: 1px solid var(--csg-line); border-radius: 12px; padding: 16px 18px; }#carbon-size-guide-mens-swim-shorts .csg-more-h { margin: 0 0 4px; font-family: var(--csg-display); font-weight: 600;
  font-size: clamp(17px, 1.5vw, 21px); letter-spacing: .04em; text-transform: uppercase; }#carbon-size-guide-mens-swim-shorts .csg-more-sub { margin: 0 0 14px; font-size: 13px; color: var(--csg-muted); }#carbon-size-guide-mens-swim-shorts .csg-kv { display: grid; grid-template-columns: 1fr 1fr; gap: 13px 18px; }#carbon-size-guide-mens-swim-shorts .csg-kv > div { min-width: 0; }#carbon-size-guide-mens-swim-shorts .csg-k { display: block; font-size: 11.5px; letter-spacing: .09em; text-transform: uppercase; color: var(--csg-muted); }#carbon-size-guide-mens-swim-shorts .csg-v { display: block; font-family: var(--csg-display); font-weight: 600; font-size: 20px; margin-top: 2px; }#carbon-size-guide-mens-swim-shorts .csg-basis { margin: 14px 2px 0; font-size: 12.5px; line-height: 1.5; color: #6b7280; max-width: 64ch; }/* ── Desktop placement ───────────────────────────────────────────────────
