#carbon-size-guide-mens-swim-shorts .csg-title-fit {
  display: block; font-family: var(--csg-display); font-weight: 700;
  font-size: clamp(26px, 4.2vw, 56px); letter-spacing: -.005em;
  text-transform: uppercase; white-space: nowrap;
}#carbon-size-guide-mens-swim-shorts .csg-title-sub {
  display: block; font-family: var(--csg-display); font-weight: 300;
  font-size: clamp(21px, 3vw, 38px); letter-spacing: .005em;
  text-transform: uppercase; color: var(--csg-ink);
}#carbon-size-guide-mens-swim-shorts .csg-rule { display: block; width: 148px; height: 4px; background: var(--csg-blue); margin: 14px 0 0; }#carbon-size-guide-mens-swim-shorts .csg-subtitle {
  grid-column: 1; grid-row: 2;
  margin: 0 0 22px; font-size: clamp(14px, 1.05vw, 16px); line-height: 1.55;
  color: var(--csg-muted); max-width: 44ch;
}/* unit switch, top right of the header */
#carbon-size-guide-mens-swim-shorts .csg-units {
