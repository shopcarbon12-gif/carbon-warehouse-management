    grid-template-rows: auto auto; column-gap: 12px; row-gap: 4px;
    border: 0; border-top: 1px solid var(--csg-line); border-radius: 0; padding: 12px 0 0;
  }#carbon-size-guide-mens-swim-shorts .csg-card:first-child { border-top: 0; padding-top: 0; }#carbon-size-guide-mens-swim-shorts .csg-figure { grid-row: 1 / span 2; }/* At thumbnail size a letterboxed photo is mostly empty grey, so the two
     flat-lays fill their square. The inseam keeps contain — cropping the one
     photo whose whole job is crotch-to-hem would defeat it. */
#carbon-size-guide-mens-swim-shorts .csg-photo { aspect-ratio: 1 / 1; object-fit: cover; }#carbon-size-guide-mens-swim-shorts .csg-photo-inseam { object-fit: contain; }#carbon-size-guide-mens-swim-shorts .csg-card-head { grid-column: 2; }#carbon-size-guide-mens-swim-shorts .csg-card-text { grid-column: 2; font-size: 13.5px; }#carbon-size-guide-mens-swim-shorts .csg-tips { flex-direction: column; align-items: flex-start; gap: 10px; }#carbon-size-guide-mens-swim-shorts .csg-tips-list { grid-template-columns: 1fr; gap: 9px; }#carbon-size-guide-mens-swim-shorts .csg-note { font-size: 13.5px; }
