  --csg-body: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;

  /* One grid for the whole component. Desktop places the pieces into two
     columns with the measurement section spanning the description and table
     rows, so HOW TO MEASURE starts level with the description exactly as in the
     comp. Phone collapses to one column and re-orders, rather than inheriting
     the desktop sequence. */
  display: grid;
  grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
  column-gap: clamp(22px, 3vw, 44px);
  align-items: start;
  font-family: var(--csg-body);
  color: var(--csg-ink);
  background: #fff;
