  -webkit-font-smoothing: antialiased;
  text-align: left;
}#carbon-size-guide-mens-swim-shorts * { box-sizing: border-box; min-width: 0; }#carbon-size-guide-mens-swim-shorts :focus-visible { outline: 2px solid var(--csg-blue); outline-offset: 2px; border-radius: 3px; }/* ── header ─────────────────────────────────────────────────────────── */
/* Spans both columns so a long fit name has the whole modal to sit on one
   line, with room reserved on the right for the unit switch that shares the
   row. */
#carbon-size-guide-mens-swim-shorts .csg-top {
  grid-column: 1 / -1; grid-row: 1;
  padding-right: 210px;
  margin-bottom: clamp(16px, 1.8vw, 24px);
}#carbon-size-guide-mens-swim-shorts .csg-units-cell { display: contents; }#carbon-size-guide-mens-swim-shorts .csg-wordmark {
  /* The wordmark is the brand's own letterform — a normal-width grotesque with
     wide tracking. Setting it in the condensed headline face made it read as a
     label rather than as the logo. */
  font-family: var(--csg-body); font-weight: 700;
