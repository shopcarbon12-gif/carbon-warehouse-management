#carbon-size-guide-mens-swim-shorts .csg-subtitle { grid-column: 1 / -1; grid-row: 2; max-width: 78ch; }#carbon-size-guide-mens-swim-shorts .csg-chart { grid-column: 1;      grid-row: 3 / span 2; }#carbon-size-guide-mens-swim-shorts .csg-more { grid-column: 2;      grid-row: 3; align-self: start; }#carbon-size-guide-mens-swim-shorts .csg-note-wrap { grid-column: 2;      grid-row: 4; align-self: start; }/* phone: size buttons then every measurement, hidden on desktop */
#carbon-size-guide-mens-swim-shorts .csg-mob { display: none; }#carbon-size-guide-mens-swim-shorts .csg-sizes { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 16px; }#carbon-size-guide-mens-swim-shorts .csg-size {
