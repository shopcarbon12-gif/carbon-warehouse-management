  font-size: 13px; font-weight: 700; font-style: italic; font-family: var(--csg-body);
}#carbon-size-guide-mens-swim-shorts .csg-note b, #carbon-size-guide-mens-swim-shorts .csg-note strong { color: var(--csg-blue); }/* ── tips strip ─────────────────────────────────────────────────────── */
#carbon-size-guide-mens-swim-shorts .csg-tips {
  grid-column: 1 / -1;
  /* nowrap so the tagline stays pinned right against its divider; the list of
     tips wraps inside its own track instead of pushing the tagline onto a line
     of its own. */
  display: flex; align-items: center; gap: clamp(14px, 1.8vw, 26px); flex-wrap: nowrap;
  margin: clamp(22px, 2.6vw, 32px) 0 0; padding: 18px clamp(16px, 1.8vw, 24px);
  border: 1px solid var(--csg-line); border-radius: 12px;
}#carbon-size-guide-mens-swim-shorts .csg-tips-icon { flex: 0 0 auto; color: var(--csg-ink); display: grid; place-items: center; }#carbon-size-guide-mens-swim-shorts .csg-tips-title {
  margin: 0; flex: 0 0 auto; font-family: var(--csg-display); font-weight: 600;
  font-size: 17px; letter-spacing: .05em; text-transform: uppercase;
}#carbon-size-guide-mens-swim-shorts .csg-tips-list {
  /* Three equal columns rather than a flex row: the three tips do not fit on one
     line beside the title and the tagline at this width, and a flex row put two
     on the first line and one alone on a second. A column each keeps the rhythm
     of the comp, and only the longest tip runs to a second line. */
  margin: 0; padding: 0; list-style: none;
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px clamp(12px, 1.3vw, 20px); flex: 1 1 auto;
}#carbon-size-guide-mens-swim-shorts .csg-tips-list li { display: flex; align-items: flex-start; gap: 7px; font-size: 13.5px; line-height: 1.4; color: var(--csg-muted); }#carbon-size-guide-mens-swim-shorts .csg-tick { flex: 0 0 auto; color: var(--csg-blue); margin-top: 1px; }#carbon-size-guide-mens-swim-shorts .csg-tagline {
  margin: 0; flex: 0 0 auto; padding-left: clamp(14px, 1.8vw, 26px);
  border-left: 1px solid var(--csg-line); font-size: 11.5px; line-height: 1.7;
  letter-spacing: .16em; text-transform: uppercase; color: #9aa3b2; text-align: right;
}

/* ── tablet ─────────────────────────────────────────────────────────── */
@media (max-width: 1000px) {#carbon-size-guide-mens-swim-shorts { grid-template-columns: 1fr; }#carbon-size-guide-mens-swim-shorts .csg-top, #carbon-size-guide-mens-swim-shorts .csg-units, #carbon-size-guide-mens-swim-shorts .csg-subtitle, #carbon-size-guide-mens-swim-shorts .csg-picker, #carbon-size-guide-mens-swim-shorts .csg-chart, #carbon-size-guide-mens-swim-shorts .csg-measure, #carbon-size-guide-mens-swim-shorts .csg-tips {
    grid-column: 1; grid-row: auto;
  }/* The comp reads name, then description, then the unit switch. */
#carbon-size-guide-mens-swim-shorts .csg-top { order: 1; padding-right: 0; }#carbon-size-guide-mens-swim-shorts .csg-subtitle { order: 2; }#carbon-size-guide-mens-swim-shorts .csg-units { order: 3; justify-self: stretch; }#carbon-size-guide-mens-swim-shorts .csg-picker { order: 4; }#carbon-size-guide-mens-swim-shorts .csg-chart { order: 5; }#carbon-size-guide-mens-swim-shorts .csg-measure { order: 6; }#carbon-size-guide-mens-swim-shorts .csg-tips { order: 7; }#carbon-size-guide-mens-swim-shorts .csg-measure { margin-top: 20px; }#carbon-size-guide-mens-swim-shorts .csg-tips { flex-wrap: wrap; }#carbon-size-guide-mens-swim-shorts .csg-tagline { display: none; }
}

/* ── phone: a different layout, not a smaller one ───────────────────── */
@media (max-width: 680px) {#carbon-size-guide-mens-swim-shorts { padding: 16px; }#carbon-size-guide-mens-swim-shorts .csg-units { width: 100%; justify-content: stretch; }#carbon-size-guide-mens-swim-shorts .csg-unit { flex: 1 1 0; padding: 11px 0; }#carbon-size-guide-mens-swim-shorts .csg-subtitle { font-size: 13.5px; }#carbon-size-guide-mens-swim-shorts .csg-picker { display: block; }#carbon-size-guide-mens-swim-shorts .csg-table thead th { font-size: 11.5px; padding: 9px 4px; letter-spacing: .04em; }#carbon-size-guide-mens-swim-shorts .csg-th-unit { font-size: 10.5px; }#carbon-size-guide-mens-swim-shorts .csg-table tbody th, #carbon-size-guide-mens-swim-shorts .csg-table tbody td { font-size: 14px; padding: 10px 4px; }/* The measure section becomes a real accordion, and each card becomes a row
     with a thumbnail — three tall photo cards in a column is a lot of scrolling
     for something read once. */
#carbon-size-guide-mens-swim-shorts .csg-measure { border: 1px solid var(--csg-line); border-radius: 12px; padding: 14px; margin-top: 18px; }#carbon-size-guide-mens-swim-shorts .csg-measure > summary { cursor: pointer; margin-bottom: 0; }#carbon-size-guide-mens-swim-shorts .csg-measure[open] > summary { margin-bottom: 14px; }#carbon-size-guide-mens-swim-shorts .csg-chev { display: block; transition: transform .2s ease; }#carbon-size-guide-mens-swim-shorts .csg-measure[open] .csg-chev { transform: rotate(180deg); }#carbon-size-guide-mens-swim-shorts .csg-cards { grid-template-columns: 1fr; gap: 12px; }#carbon-size-guide-mens-swim-shorts .csg-card {
