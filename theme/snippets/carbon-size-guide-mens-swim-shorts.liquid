  transition: background-color .18s ease, color .18s ease;
}#carbon-size-guide-mens-swim-shorts .csg-unit[aria-pressed="true"] { background: var(--csg-blue); color: #fff; }/* ── mobile size picker (hidden on desktop, where rows are clicked) ──── */
#carbon-size-guide-mens-swim-shorts .csg-picker { display: none; grid-column: 1; grid-row: 3; margin: 0 0 16px; }#carbon-size-guide-mens-swim-shorts .csg-picker-label {
  display: block; font-size: 13px; color: var(--csg-muted); margin: 0 0 6px;
}#carbon-size-guide-mens-swim-shorts .csg-select {
  width: 100%; appearance: none; background: #fff url("data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='14' height='9' viewBox='0 0 14 9'%3E%3Cpath d='M1 1l6 6 6-6' fill='none' stroke='%230f172a' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E") no-repeat right 14px center;
  border: 1px solid var(--csg-line); border-radius: 10px;
  padding: 13px 40px 13px 14px; font-family: var(--csg-display); font-weight: 600;
  font-size: 19px; color: var(--csg-ink);
}/* ── two-column body ────────────────────────────────────────────────── */
#carbon-size-guide-mens-swim-shorts .csg-chart { grid-column: 1; grid-row: 4; }/* Spans the description and chart rows so its heading sits level with the
   description, not below the whole header. */
#carbon-size-guide-mens-swim-shorts .csg-measure { grid-column: 2; grid-row: 2 / 5; }/* ── table ──────────────────────────────────────────────────────────── */
#carbon-size-guide-mens-swim-shorts .csg-table {
  width: 100%; border-collapse: separate; border-spacing: 0;
  border: 1px solid var(--csg-line); border-radius: 10px; overflow: hidden;
  font-variant-numeric: tabular-nums;
}#carbon-size-guide-mens-swim-shorts .csg-table thead th {
  background: var(--csg-navy); color: #fff; text-align: center;
