<!-- CARBON interactive size guide: Men's Swim Shorts (custom.size_guide_type = mens-swim-shorts) -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&display=swap">
<div id="carbon-size-guide-mens-swim-shorts" class="carbon-size-guide" data-fit="mens-swim-shorts">
<style>
/* Every selector is prefixed with the component's own id at build time, so this
   file is written unprefixed and stays readable. Nothing here can reach the rest
   of the product page. */
#carbon-size-guide-mens-swim-shorts {
  --csg-ink: #0f172a;
  --csg-navy: #16233a;
  --csg-blue: #1d4ed8;
  --csg-blue-soft: #eff6ff;
  --csg-line: #e5e7eb;
  --csg-zebra: #f8fafc;
  --csg-muted: #4b5563;
