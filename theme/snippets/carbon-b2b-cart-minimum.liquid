{%- comment -%}
  Wholesale cart rules (owner 2026-11-07). Rendered in the cart drawer and on
  the cart page, next to Checkout. Retail carts are untouched.

  1. A run is one of EVERY size of a colour (a one-size colour's run is 3
     pieces). A colour's complete runs = the lowest quantity across ALL its
     sizes — a size missing from the cart counts as 0.
  2. A broken run is not sold: if any line of a colour doesn't match that
     colour's complete runs (a size was removed or changed), the script below
     sets every line of that colour back to its complete runs — so removing one
     size takes the rest of that colour's run out of the cart too (the fix is
     applied by snippets/carbon-b2b-cart-fixer.liquid). Until the cart is
     consistent, Checkout is hidden.
  3. Minimum 3 complete runs PER ORDER, mixed any way. Below it, Checkout is
     hidden and the buyer is told how many runs are missing.

  Shopify's own per-variant quantity rules cannot express runs (and cart
  functions need Shopify Plus), so this is where the rules live.
{%- endcomment -%}
{%- if customer.b2b? and cart.item_count > 0 -%}
  {%- liquid
    assign order_min_runs = 3
    assign keys = ''
    for item in cart.items
      assign colour = '—'
      for option in item.product.options_with_values
        assign option_name = option.name | downcase
        if option_name contains 'colo'
          assign colour = item.variant.options[forloop.index0]
        endif
      endfor
      assign key = item.product_id | append: '~' | append: colour
      assign keys = keys | append: key | append: '||'
    endfor
    assign keys = keys | split: '||' | uniq

    assign total_runs = 0
    assign fixes = ''
    for key in keys
      assign key_min = 999999
      assign key_lines = 0
      assign colour_sizes = 0
      assign key_per = 1
      for item in cart.items
        assign colour = '—'
        for option in item.product.options_with_values
          assign option_name = option.name | downcase
          if option_name contains 'colo'
            assign colour = item.variant.options[forloop.index0]
          endif
        endfor
        assign item_key = item.product_id | append: '~' | append: colour
        if item_key == key
          assign key_lines = key_lines | plus: 1
          if item.quantity < key_min
            assign key_min = item.quantity
          endif
          if colour_sizes == 0
            for v in item.product.variants
              if colour == '—'
                assign colour_sizes = colour_sizes | plus: 1
              elsif v.options contains colour
                assign colour_sizes = colour_sizes | plus: 1
              endif
            endfor
          endif
        endif
      endfor
      if colour_sizes == 1
        assign key_per = 3
      endif
      # A size of the colour that is not in the cart counts as 0 runs.
      if key_lines < colour_sizes
        assign key_min = 0
      endif
      assign key_runs = key_min | divided_by: key_per
      assign target = key_runs | times: key_per
      assign total_runs = total_runs | plus: key_runs

      for item in cart.items
        assign colour = '—'
        for option in item.product.options_with_values
          assign option_name = option.name | downcase
          if option_name contains 'colo'
            assign colour = item.variant.options[forloop.index0]
          endif
        endfor
        assign item_key = item.product_id | append: '~' | append: colour
        if item_key == key and item.quantity != target
          assign fixes = fixes | append: '"' | append: item.key | append: '":' | append: target | append: ','
        endif
      endfor
    endfor
    assign missing = order_min_runs | minus: total_runs
  -%}
  {%- if fixes != blank -%}
    <div class="carbon-b2b-min" role="alert" data-carbon-b2b-fix='{"updates":{ {{- fixes | remove_last: ',' -}} }}'>
      <strong>{{ 'carbon.b2b.cart_min.broken_heading' | t }}</strong>
      {{ 'carbon.b2b.cart_min.broken_text' | t }}
    </div>
  {%- elsif missing > 0 -%}
    <div class="carbon-b2b-min" role="alert">
      <strong>{{ 'carbon.b2b.cart_min.heading' | t: min: order_min_runs }}</strong>
      {% if total_runs == 1 %}{{ 'carbon.b2b.cart_min.cart_has_one' | t: n: total_runs }}{% else %}{{ 'carbon.b2b.cart_min.cart_has_other' | t: n: total_runs }}{% endif %}
      {% if missing == 1 %}{{ 'carbon.b2b.cart_min.add_more_one' | t: n: missing }}{% else %}{{ 'carbon.b2b.cart_min.add_more_other' | t: n: missing }}{% endif %}
    </div>
  {%- else -%}
    <p class="carbon-b2b-min carbon-b2b-min--ok">{{ 'carbon.b2b.cart_min.met' | t: n: total_runs }}</p>
  {%- endif -%}
  {%- if fixes != blank or missing > 0 -%}
    <style>
      /* Broken run or below the wholesale minimum: no way to checkout from the drawer or cart page. */
      .checkout-button,
      .additional-checkout-buttons,
      .cart__dynamic-checkout-buttons,
      [name="checkout"] { display: none !important; }
    </style>
  {%- endif -%}
  <style>
    .carbon-b2b-min { margin: 0 0 12px; padding: 10px 12px; font-size: 0.8125rem; line-height: 1.4; border: 1px solid #c0392b; border-radius: 4px; }
    .carbon-b2b-min strong { display: block; }
    .carbon-b2b-min--ok { border-color: rgba(var(--color-body-rgb, 0, 0, 0), 0.2); opacity: 0.85; }
  </style>
  {%- comment -%} The fix itself runs in snippets/carbon-b2b-cart-fixer.liquid (layout), because the drawer is re-rendered with innerHTML and scripts in it would not run. {%- endcomment -%}
{%- endif -%}
